# Build stage for the tincstack core daemon (tinc 1.1 fork, meson build).
#
# Since M5 (G3) this is also the QUIC build: the `quicdeps` stage builds ngtcp2
# (QUIC transport library, no I/O, no threads -- the caller owns the socket and
# the event loop) with its OpenSSL crypto backend from a pinned, checksummed
# release tarball, so that pkg-config resolves
#
#     libngtcp2               (the QUIC state machine)
#     libngtcp2_crypto_ossl   (TLS 1.3 handshake glue on OpenSSL 3.5's QUIC API)
#
# and meson's `-Dquic=enabled` compiles the `quic` carrier. Folded into the
# one image (decision, G3): the alternative -- a separate QUIC image -- would
# leave the default node without the carrier, and "tick QUIC on one side"
# (decision 2) only works if every peer's build has it. A QUIC-less build stays
# possible and is checked in CI-style with `-Dquic=disabled` (see
# docs/transports.md §9.10). Why ngtcp2 and not msquic: docs/transports.md §9.1.
#
# Debian 13 (trixie), since 2026-09-23: its OpenSSL 3.5 gives both carriers --
# the https TLS client and server, the QUIC client and server -- one TLS stack,
# the one curl 8.14 and nginx on trixie use (the fingerprint audit found
# GnuTLS 3.7.9's QUIC ClientHello unique, and an OpenSSL 3.0 TLS ClientHello no
# current client sends; docs/transports.md §9.8). ngtcp2 is still built from
# source: trixie ships 1.11 without the ossl backend.

FROM debian:13-slim AS quicdeps
ARG NGTCP2_VERSION=1.25.0
ARG NGTCP2_SHA256=2a34d2484ba17847a5d11965704e9dd0fac4c6d8efc75ffe1ec7de66d8c6b6fb
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config libssl-dev \
        ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN curl -fsSL -o ngtcp2.tar.xz \
        "https://github.com/ngtcp2/ngtcp2/releases/download/v${NGTCP2_VERSION}/ngtcp2-${NGTCP2_VERSION}.tar.xz" \
    && echo "${NGTCP2_SHA256}  ngtcp2.tar.xz" | sha256sum -c - \
    && tar xJf ngtcp2.tar.xz \
    && cd "ngtcp2-${NGTCP2_VERSION}" \
    && ./configure --prefix=/usr/local --with-openssl --without-gnutls --enable-lib-only \
    && make -j"$(nproc)" \
    && make DESTDIR=/install install \
    && rm -rf /build/*

FROM debian:13-slim AS build
ARG QUIC=enabled
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential meson ninja-build pkg-config \
        libssl-dev zlib1g-dev liblzo2-dev liblz4-dev \
        libncurses-dev libreadline-dev python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=quicdeps /install/usr/local/ /usr/local/
RUN ldconfig \
    && pkg-config --modversion openssl libngtcp2 libngtcp2_crypto_ossl
WORKDIR /src
COPY tincd/ /src/
RUN meson setup build --prefix=/usr/local --localstatedir=/var \
        -Dbuildtype=release -Dminiupnpc=disabled -Dtests=disabled -Ddocs=disabled \
        -Dquic=${QUIC} \
    && ninja -C build \
    && DESTDIR=/install ninja -C build install

FROM debian:13-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl3t64 zlib1g liblzo2-2 liblz4-1 libncursesw6 libreadline8t64 \
        iproute2 iputils-ping iptables ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /install/usr/local/ /usr/local/
COPY --from=quicdeps /install/usr/local/lib/libngtcp2.so* /install/usr/local/lib/libngtcp2_crypto_ossl.so* /usr/local/lib/
RUN ldconfig
