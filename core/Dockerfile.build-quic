# Variant of Dockerfile.build with the QUIC carrier's dependency (M5, stream Q).
#
# Adds one stage, `quicdeps`, that builds ngtcp2 (QUIC transport library, no
# I/O, no threads — the caller owns the socket and the event loop) together with
# its GnuTLS crypto backend from a pinned, checksummed release tarball, and
# installs it under /usr/local so that pkg-config resolves
#
#     libngtcp2               (the QUIC state machine)
#     libngtcp2_crypto_gnutls (TLS 1.3 handshake glue on Debian 12's gnutls 3.7.9)
#
# The `build` stage is Dockerfile.build's build stage plus those two libraries,
# so a future `-Dquic=enabled` meson option can find them with
# dependency('libngtcp2') / dependency('libngtcp2_crypto_gnutls'). The tincd
# sources are built unchanged here (there is no quic option yet); this file
# proves the dependency is reproducible and that the core still builds with it
# present. The runtime stage carries the shared objects and libgnutls30.
#
# Why ngtcp2 and not msquic: see docs/transports.md, "QUIC carrier (design,
# stream Q)". Why a source build and not Debian's libngtcp2-dev: bookworm ships
# 0.12.1, a pre-1.0 API that no longer matches upstream; 1.x is the stable API
# and the same tarball also cross-builds for the Windows/Android targets.

FROM debian:12-slim AS quicdeps
ARG NGTCP2_VERSION=1.25.0
ARG NGTCP2_SHA256=2a34d2484ba17847a5d11965704e9dd0fac4c6d8efc75ffe1ec7de66d8c6b6fb
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config libgnutls28-dev \
        ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN curl -fsSL -o ngtcp2.tar.xz \
        "https://github.com/ngtcp2/ngtcp2/releases/download/v${NGTCP2_VERSION}/ngtcp2-${NGTCP2_VERSION}.tar.xz" \
    && echo "${NGTCP2_SHA256}  ngtcp2.tar.xz" | sha256sum -c - \
    && tar xJf ngtcp2.tar.xz \
    && cd "ngtcp2-${NGTCP2_VERSION}" \
    && ./configure --prefix=/usr/local --with-gnutls --enable-lib-only \
    && make -j"$(nproc)" \
    && make DESTDIR=/install install \
    && rm -rf /build/*

# Build stage: Dockerfile.build's build stage + the QUIC dependency.
FROM debian:12-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential meson ninja-build pkg-config \
        libssl-dev zlib1g-dev liblzo2-dev liblz4-dev \
        libncurses-dev libreadline-dev python3 ca-certificates \
        libgnutls28-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=quicdeps /install/usr/local/ /usr/local/
RUN ldconfig \
    && pkg-config --modversion libngtcp2 libngtcp2_crypto_gnutls \
    && pkg-config --cflags --libs libngtcp2_crypto_gnutls
WORKDIR /src
COPY tincd/ /src/
RUN meson setup build --prefix=/usr/local --localstatedir=/var \
        -Dbuildtype=release -Dminiupnpc=disabled -Dtests=disabled -Ddocs=disabled \
    && ninja -C build \
    && DESTDIR=/install ninja -C build install

FROM debian:12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl3 zlib1g liblzo2-2 liblz4-1 libncursesw6 libreadline8 \
        libgnutls30 \
        iproute2 iputils-ping iptables ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /install/usr/local/ /usr/local/
COPY --from=quicdeps /install/usr/local/lib/libngtcp2.so* /install/usr/local/lib/libngtcp2_crypto_gnutls.so* /usr/local/lib/
RUN ldconfig
