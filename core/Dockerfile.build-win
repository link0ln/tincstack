# Windows (x86_64, mingw-w64) cross-build of the tincstack core.
#
# Produces tincd.exe + tinc.exe for the Windows GUI (platforms/windows) to bundle.
#
# Since 2026-09-23 with the TLS carriers (`https', `quic'): OpenSSL 3.5 -- the
# same version as the Linux image's Debian 13 package -- and ngtcp2 with its
# OpenSSL backend are cross-built here from pinned, checksummed tarballs and
# linked statically, so tincd.exe needs no OpenSSL DLL and its ClientHellos
# are the Linux build's (docs/transports.md §9.10: a different TLS library
# per platform would give each platform its own fingerprint). Until then this
# was a libgcrypt build without either carrier.
#
# OpenSSL is configured for a binary that runs elevated:
#   no-autoload-config  OPENSSL_init does not read openssl.cnf (on Windows a
#                       config file is a code-loading vector, CVE-2019-1552);
#   no-module no-dso    no provider or engine DLLs loaded at run time;
#   --openssldir        under Program Files (admin-only) should anything look.
#
#   docker build -f core/Dockerfile.build-win -t tincstack/core-win:dev core/
#   docker run --rm -v "$PWD/platforms/windows/resources:/out" tincstack/core-win:dev
#
# The default CMD copies tincd.exe / tinc.exe into /out. wintun.dll is NOT built
# here -- it is a signed Microsoft-signed binary from https://www.wintun.net/
# (see platforms/windows/build-windows.md).
FROM debian:13-slim AS build
ARG ZLIB_VERSION=1.3.1
ARG ZLIB_SHA256=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
ARG ZSTD_VERSION=1.5.7
ARG ZSTD_SHA256=eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3
ARG OPENSSL_VERSION=3.5.7
ARG OPENSSL_SHA256=a8c0d28a529ca480f9f36cf5792e2cd21984552a3c8e4aa11a24aa31aeac98e8
ARG NGTCP2_VERSION=1.25.0
ARG NGTCP2_SHA256=2a34d2484ba17847a5d11965704e9dd0fac4c6d8efc75ffe1ec7de66d8c6b6fb
ARG MINGW=/usr/x86_64-w64-mingw32
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential meson ninja-build pkg-config python3 perl ca-certificates \
        curl xz-utils mingw-w64 mingw-w64-tools binutils-mingw-w64-x86-64 file \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /deps
# zlib and zstd: Debian builds its OpenSSL with both (-DZLIB -DZSTD), so its
# ClientHello offers compress_certificate (zlib, zstd). Without them ours
# lacked that one extension -- a different JA4 from the Linux build's
# (testing/transports/windows-wine-test.sh). Same versions as Debian 13.
RUN curl -fsSL -o zlib.tar.gz \
        "https://github.com/madler/zlib/releases/download/v${ZLIB_VERSION}/zlib-${ZLIB_VERSION}.tar.gz" \
    && echo "${ZLIB_SHA256}  zlib.tar.gz" | sha256sum -c - \
    && tar xzf zlib.tar.gz && cd "zlib-${ZLIB_VERSION}" \
    && make -f win32/Makefile.gcc PREFIX=x86_64-w64-mingw32- libz.a \
    && install -m644 libz.a "${MINGW}/lib/" && install -m644 zlib.h zconf.h "${MINGW}/include/" \
    && cd /deps && rm -rf zlib*
RUN curl -fsSL -o zstd.tar.gz \
        "https://github.com/facebook/zstd/releases/download/v${ZSTD_VERSION}/zstd-${ZSTD_VERSION}.tar.gz" \
    && echo "${ZSTD_SHA256}  zstd.tar.gz" | sha256sum -c - \
    && tar xzf zstd.tar.gz && cd "zstd-${ZSTD_VERSION}/lib" \
    && make -j"$(nproc)" libzstd.a CC=x86_64-w64-mingw32-gcc AR=x86_64-w64-mingw32-ar ZSTD_LEGACY_SUPPORT=0 \
    && install -m644 libzstd.a "${MINGW}/lib/" && install -m644 zstd.h zstd_errors.h zdict.h "${MINGW}/include/" \
    && cd /deps && rm -rf zstd*
RUN curl -fsSL -o openssl.tar.gz \
        "https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz" \
    && echo "${OPENSSL_SHA256}  openssl.tar.gz" | sha256sum -c - \
    && tar xzf openssl.tar.gz && cd "openssl-${OPENSSL_VERSION}" \
    && ./Configure mingw64 --cross-compile-prefix=x86_64-w64-mingw32- \
        --prefix="${MINGW}" --libdir=lib \
        --openssldir="C:/Program Files/tincstack/ssl" \
        no-shared no-module no-dso no-autoload-config no-tests no-docs no-apps \
        enable-zlib enable-zstd \
        --with-zlib-include="${MINGW}/include" --with-zlib-lib="${MINGW}/lib" \
        --with-zstd-include="${MINGW}/include" --with-zstd-lib="${MINGW}/lib" \
    && make -j"$(nproc)" build_libs \
    && make install_dev \
    && cd /deps && rm -rf openssl*
RUN curl -fsSL -o ngtcp2.tar.xz \
        "https://github.com/ngtcp2/ngtcp2/releases/download/v${NGTCP2_VERSION}/ngtcp2-${NGTCP2_VERSION}.tar.xz" \
    && echo "${NGTCP2_SHA256}  ngtcp2.tar.xz" | sha256sum -c - \
    && tar xJf ngtcp2.tar.xz && cd "ngtcp2-${NGTCP2_VERSION}" \
    && export PKG_CONFIG_LIBDIR="${MINGW}/lib/pkgconfig" \
    && ./configure --host=x86_64-w64-mingw32 --prefix="${MINGW}" \
        --enable-lib-only --disable-shared --enable-static --with-openssl --without-gnutls \
        OPENSSL_LIBS="$(pkg-config --static --libs openssl)" \
    && make -j"$(nproc)" && make install \
    && cd /deps && rm -rf ngtcp2*
RUN x86_64-w64-mingw32-pkg-config --static --modversion openssl libngtcp2 libngtcp2_crypto_ossl
WORKDIR /src
COPY tincd/ /src/
# Compression libraries have no mingw packages in Debian; the meson wraps would
# download them at build time. Keep the build offline/deterministic: no
# compression (tinc's Compression option is 0 = off by default anyway).
RUN meson setup build-win --cross-file .ci/cross/windows/amd64 \
        -Dbuildtype=release -Dcrypto=openssl -Dquic=enabled -Dminiupnpc=disabled \
        -Dzlib=disabled -Dlzo=disabled -Dlz4=disabled \
        -Dcurses=disabled -Dreadline=disabled \
        -Dtests=disabled -Ddocs=disabled --wrap-mode=nodownload \
    && ninja -C build-win \
    && mkdir -p /dist \
    && cp build-win/src/tincd.exe build-win/src/tinc.exe /dist/ \
    && x86_64-w64-mingw32-strip /dist/tincd.exe /dist/tinc.exe \
    && file /dist/tincd.exe /dist/tinc.exe \
    && x86_64-w64-mingw32-objdump -p /dist/tincd.exe | grep -E 'DLL Name' \
    && sha256sum /dist/*.exe > /dist/SHA256SUMS

FROM debian:13-slim
COPY --from=build /dist/ /dist/
VOLUME /out
CMD ["sh", "-c", "cp -v /dist/tincd.exe /dist/tinc.exe /dist/SHA256SUMS /out/ && cat /out/SHA256SUMS"]
