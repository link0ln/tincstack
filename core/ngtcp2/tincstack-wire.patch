+  /* OpenSSL 3.5, ssl/quic/quic_channel.c ch_generate_transport_params */
+  const struct {
+    ngtcp2_transport_param_id id;
+    uint64_t value;
+    int present;
+  } varints[] = {
+    {NGTCP2_TRANSPORT_PARAM_MAX_IDLE_TIMEOUT,
+     params->max_idle_timeout / NGTCP2_MILLISECONDS,
+     params->max_idle_timeout != 0},
+    {NGTCP2_TRANSPORT_PARAM_MAX_UDP_PAYLOAD_SIZE,
+     params->max_udp_payload_size,
+     params->max_udp_payload_size != NGTCP2_DEFAULT_MAX_RECV_UDP_PAYLOAD_SIZE},
+    {NGTCP2_TRANSPORT_PARAM_ACTIVE_CONNECTION_ID_LIMIT,
+     active_connection_id_limit, 1},
+    {NGTCP2_TRANSPORT_PARAM_INITIAL_MAX_DATA, params->initial_max_data,
+     params->initial_max_data != 0},
+    {NGTCP2_TRANSPORT_PARAM_INITIAL_MAX_STREAM_DATA_BIDI_LOCAL,
+     params->initial_max_stream_data_bidi_local,
+     params->initial_max_stream_data_bidi_local != 0},
+    {NGTCP2_TRANSPORT_PARAM_INITIAL_MAX_STREAM_DATA_BIDI_REMOTE,
+     params->initial_max_stream_data_bidi_remote,
+     params->initial_max_stream_data_bidi_remote != 0},
+    {NGTCP2_TRANSPORT_PARAM_INITIAL_MAX_STREAM_DATA_UNI,
+     params->initial_max_stream_data_uni,
+     params->initial_max_stream_data_uni != 0},
+    {NGTCP2_TRANSPORT_PARAM_INITIAL_MAX_STREAMS_BIDI,
+     params->initial_max_streams_bidi, params->initial_max_streams_bidi != 0},
+    {NGTCP2_TRANSPORT_PARAM_INITIAL_MAX_STREAMS_UNI,
+     params->initial_max_streams_uni, params->initial_max_streams_uni != 0},
+  };
+
+  assert(params->initial_scid_present);
+
+  if (params->disable_active_migration) {
+    len += zero_paramlen(NGTCP2_TRANSPORT_PARAM_DISABLE_ACTIVE_MIGRATION);
+  }
+  len += cid_paramlen(NGTCP2_TRANSPORT_PARAM_INITIAL_SOURCE_CONNECTION_ID,
+                      &params->initial_scid);
+  for (i = 0; i < sizeof(varints) / sizeof(varints[0]); ++i) {
+    if (varints[i].present) {
+      len += varint_paramlen(varints[i].id, varints[i].value);
+    }
+  }
+
+  if (dest == NULL && destlen == 0) {
+    return (ngtcp2_ssize)len;
+  }
+
+  if (destlen < len) {
+    return NGTCP2_ERR_NOBUF;
+  }
+
+  p = dest;
+
+  if (params->disable_active_migration) {
+    p = write_zero_param(p, NGTCP2_TRANSPORT_PARAM_DISABLE_ACTIVE_MIGRATION);
+  }
+  p = write_cid_param(p, NGTCP2_TRANSPORT_PARAM_INITIAL_SOURCE_CONNECTION_ID,
+                      &params->initial_scid);
+  for (i = 0; i < sizeof(varints) / sizeof(varints[0]); ++i) {
+    if (varints[i].present) {
+      p = write_varint_param(p, varints[i].id, varints[i].value);
+    }
+  }
+
+  assert((size_t)(p - dest) == len);
+
+  return (ngtcp2_ssize)len;
+}
