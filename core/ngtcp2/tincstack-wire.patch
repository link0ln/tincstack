+void ngtcp2_conn_set_openssl_client_wire(
+  ngtcp2_conn *conn, uint64_t wire_active_connection_id_limit) {
+  assert(!conn->server);
+  assert(wire_active_connection_id_limit >=
+         NGTCP2_DEFAULT_ACTIVE_CONNECTION_ID_LIMIT);
+  assert(wire_active_connection_id_limit <=
+         conn->local.transport_params.active_connection_id_limit);
+
+  conn->local.wire.openssl_client = 1;
+  conn->local.wire.active_connection_id_limit =
+    wire_active_connection_id_limit;
+  conn->flags &= (uint32_t)~NGTCP2_CONN_FLAG_CRUMBLE_INITIAL_CRYPTO;
+}
