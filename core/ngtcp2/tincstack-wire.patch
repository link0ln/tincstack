+                                       NGTCP2_PKT_HANDSHAKE,
+                                       NGTCP2_WRITE_PKT_FLAG_NONE,
+                                       write_datalen, ts);
+  if (hs_nwrite < 0) {
+    assert(hs_nwrite != NGTCP2_ERR_NOBUF);
+    return hs_nwrite;
+  }
