+static ngtcp2_ssize conn_write_openssl_client_flight(ngtcp2_conn *conn,
+                                                     ngtcp2_pkt_info *pi,
+                                                     uint8_t *dest,
+                                                     size_t destlen,
+                                                     uint64_t write_datalen,
