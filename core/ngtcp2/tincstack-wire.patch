+    fr.ack.ranges = ack_ranges;
+    if (ngtcp2_acktr_create_ack_frame(
+          &conn->pktns.acktr, &fr.ack, NGTCP2_PKT_1RTT, ts,
+          /* ack_delay = */ 0,
+          conn->local.transport_params.ack_delay_exponent) == 0) {
