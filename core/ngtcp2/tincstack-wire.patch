+        conn, pi, tail + taillen, dgramlen - reserve - taillen,
+        NGTCP2_PKT_1RTT, NGTCP2_WRITE_PKT_FLAG_NONE, &conn->dcid.current.cid,
+        &fr, NGTCP2_RTB_ENTRY_FLAG_NONE, NULL, ts);
+      if (nwrite < 0) {
+        assert(nwrite != NGTCP2_ERR_NOBUF);
+        return nwrite;
