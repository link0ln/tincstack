+ngtcp2_ssize ngtcp2_transport_params_encode_openssl_client(
+  uint8_t *dest, size_t destlen, const ngtcp2_transport_params *params,
+  uint64_t active_connection_id_limit) {
+  uint8_t *p;
+  size_t len = 0;
