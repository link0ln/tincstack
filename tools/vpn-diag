#!/usr/bin/env python3
"""
Mesh-wide VPN diagnostics, active probing, benchmarking, and semi-automatic
remediation orchestrator for tincstack (`tinc doctor --json` + OS checks).

Reads mesh topology from (in order):
  1. --topology PATH
  2. $VPN_DIAG_TOPOLOGY
  3. /etc/tincstack/vpn-diag.json
  4. ~/.config/tincstack/vpn-diag.json
Falls back to local `tinc doctor --json` when no topology file is present.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any


DEFAULT_TOPOLOGY_PATHS = [
    Path("/etc/tincstack/vpn-diag.json"),
    Path.home() / ".config/tincstack/vpn-diag.json",
]
DEFAULT_STATE_FILE = Path.home() / ".cache/tincstack/vpn-diag-state.json"
DEFAULT_EVENTS_FILE = Path.home() / ".cache/tincstack/vpn-diag-events.jsonl"
STAGE2_CRIT_THRESHOLD = 3
STAGE2_RESTART_COOLDOWN_SEC = 900.0
EVENTS_MAX_BYTES = 2 * 1024 * 1024


def find_ssh_agent() -> str | None:
    env_sock = os.environ.get("SSH_AUTH_SOCK")
    if env_sock and os.path.exists(env_sock):
        try:
            if stat.S_ISSOCK(os.stat(env_sock).st_mode):
                return env_sock
        except OSError:
            pass

    uid = os.getuid()
    candidates: list[tuple[float, str]] = []
    tmp_dir = Path("/tmp")
    if tmp_dir.is_dir():
        for entry in tmp_dir.glob("ssh-*/agent.*"):
            try:
                st = entry.stat()
                if st.st_uid == uid and stat.S_ISSOCK(st.st_mode):
                    candidates.append((st.st_mtime, str(entry)))
            except OSError:
                continue
    if candidates:
        candidates.sort(reverse=True)
        return candidates[0][1]
    return None


def load_topology(explicit_path: str | None) -> tuple[dict[str, Any], Path | None]:
    candidates: list[Path] = []
    if explicit_path:
        candidates.append(Path(explicit_path))
    env_path = os.environ.get("VPN_DIAG_TOPOLOGY")
    if env_path:
        candidates.append(Path(env_path))
    candidates.extend(DEFAULT_TOPOLOGY_PATHS)

    for path in candidates:
        expanded = path.expanduser()
        if expanded.is_file():
            with expanded.open("r", encoding="utf-8") as fh:
                return json.load(fh), expanded
    if explicit_path:
        raise FileNotFoundError(f"Topology file not found: {explicit_path}")
    return {"nodes": []}, None


def run_cmd(argv: list[str], timeout: float = 25.0) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
        return proc.returncode, proc.stdout, proc.stderr
    except subprocess.TimeoutExpired as exc:
        return 124, exc.stdout or "", f"timeout after {timeout:.0f}s"
    except OSError as exc:
        return 127, "", str(exc)


def build_ssh_argv(
    node: dict[str, Any],
    remote_cmd: str,
    agent_sock: str | None,
    connect_timeout: int = 6,
) -> list[str]:
    ssh_target = node.get("ssh")
    if not ssh_target or ssh_target == "local":
        return ["sh", "-c", remote_cmd]

    base_opts = [
        "-o",
        "BatchMode=yes",
        "-o",
        f"ConnectTimeout={connect_timeout}",
        "-o",
        "StrictHostKeyChecking=no",
    ]
    if agent_sock:
        base_opts.extend(["-o", f"IdentityAgent={agent_sock}"])

    via_ssh = node.get("via_ssh")
    if via_ssh:
        nested = (
            "ssh -n -o BatchMode=yes "
            f"-o ConnectTimeout={connect_timeout} "
            "-o StrictHostKeyChecking=no "
            f"{shlex.quote(ssh_target)} {shlex.quote(remote_cmd)}"
        )
        return ["ssh", "-A", *base_opts, str(via_ssh), nested]

    return ["ssh", *base_opts, str(ssh_target), remote_cmd]


def run_on_node(
    node: dict[str, Any],
    remote_cmd: str,
    agent_sock: str | None,
    timeout: float = 30.0,
) -> tuple[int, str, str]:
    argv = build_ssh_argv(node, remote_cmd, agent_sock)
    return run_cmd(argv, timeout=timeout)


def detect_local_tinc_node() -> list[dict[str, Any]]:
    tinc_bin = shutil.which("tinc")
    if tinc_bin:
        return [{"name": "local", "ssh": "local", "cli": tinc_bin}]
    return []


def collect_node(
    node: dict[str, Any],
    agent_sock: str | None,
    do_probe: bool,
) -> dict[str, Any]:
    name = node.get("name", node.get("ssh", "node"))
    cli = node.get("cli", "tinc")
    doc_cmd = f"{cli} doctor --json" + (" --probe" if do_probe else "")

    result: dict[str, Any] = {
        "name": name,
        "ssh_ok": True,
        "doctor": None,
        "routes": [],
        "sockets": {},
        "ports": [],
        "pings": [],
        "logs_anomalies": [],
        "issues": [],
    }

    rc, out, err = run_on_node(node, doc_cmd, agent_sock, timeout=35.0)
    if rc == 255 and node.get("ssh") not in (None, "local"):
        result["ssh_ok"] = False
        result["issues"].append({
            "severity": "CRIT",
            "component": "ssh",
            "node": name,
            "message": f"SSH unreachable to {name}: {err.strip()}",
            "hint": "Check connectivity/SSH agent or router gateway",
        })
        return result

    try:
        doctor_json = json.loads(out)
        result["doctor"] = doctor_json
    except json.JSONDecodeError:
        result["issues"].append({
            "severity": "CRIT",
            "component": "doctor",
            "node": name,
            "message": f"Failed to parse `{doc_cmd}` output (rc={rc}): {(out or err).strip()[:200]}",
            "hint": "Ensure updated tinc CLI with `doctor` support is deployed on this node",
        })

    # Collect OS-level checks (routes, socket health, service ports, container logs, pings) in one round-trip
    os_script_parts: list[str] = ["set +e"]

    route_checks = node.get("route_checks", [])
    for idx, rchk in enumerate(route_checks):
        tbl = str(rchk["table"])
        os_script_parts.append(f"echo '__RT_{idx}_BEGIN__'")
        os_script_parts.append(f"ip route show table {shlex.quote(tbl)} 2>/dev/null")
        os_script_parts.append(f"echo '__RT_{idx}_END__'")

    port_checks = node.get("port_checks", [])
    sock_chk = node.get("socket_checks") or {}
    if port_checks or sock_chk:
        os_script_parts.append("echo '__SS_BEGIN__'")
        os_script_parts.append(
            "(ss -tan 2>/dev/null; ss -tln 2>/dev/null) || (netstat -tan 2>/dev/null; netstat -tln 2>/dev/null)"
        )
        os_script_parts.append("echo '__SS_END__'")

    container = node.get("container")
    docker_bin = node.get("docker_bin", "docker")
    if container:
        os_script_parts.append("echo '__LOG_BEGIN__'")
        os_script_parts.append(
            f"{docker_bin} logs --since 5m {shlex.quote(container)} 2>&1 | tail -n 300"
        )
        os_script_parts.append("echo '__LOG_END__'")

    pings = node.get("pings", []) if do_probe else []
    for idx, p in enumerate(pings):
        dst = shlex.quote(str(p["dst"]))
        cnt = int(p.get("count", 5))
        os_script_parts.append(f"echo '__PING_{idx}_BEGIN__'")
        os_script_parts.append(f"ping -c {cnt} -W 2 {dst} 2>&1")
        os_script_parts.append(f"echo '__PING_{idx}_END__'")

    if len(os_script_parts) > 1:
        rc_os, out_os, err_os = run_on_node(
            node,
            "\n".join(os_script_parts),
            agent_sock,
            timeout=45.0,
        )
        if rc_os == 255 and node.get("ssh") not in (None, "local"):
            result["issues"].append({
                "severity": "WARN",
                "component": "os_probe",
                "node": name,
                "message": f"OS check SSH failed on {name}: {err_os.strip()}",
                "hint": "Re-run vpn-diag",
            })
        else:
            parse_os_probe(node, out_os, result)

    return result


def extract_section(text: str, start_marker: str, end_marker: str) -> str | None:
    m = re.search(
        rf"{re.escape(start_marker)}\r?\n(.*?){re.escape(end_marker)}",
        text,
        flags=re.S,
    )
    return m.group(1) if m else None


def parse_os_probe(node: dict[str, Any], out_os: str, result: dict[str, Any]) -> None:
    name = node.get("name", "node")

    for idx, rchk in enumerate(node.get("route_checks", [])):
        sec = extract_section(out_os, f"__RT_{idx}_BEGIN__", f"__RT_{idx}_END__")
        if sec is None:
            continue
        lines = [ln.strip() for ln in sec.splitlines() if ln.strip()]
        tbl = rchk["table"]
        entry: dict[str, Any] = {"table": tbl, "count": len(lines), "ok": True}

        min_cnt = rchk.get("min_count")
        expect_sub = rchk.get("expect_contains")
        if min_cnt is not None and len(lines) < int(min_cnt):
            entry["ok"] = False
            result["issues"].append({
                "severity": "CRIT",
                "component": f"route_table_{tbl}",
                "node": name,
                "message": f"Policy table {tbl} on {name} has only {len(lines)} routes (expected >= {min_cnt})",
                "hint": rchk.get("restore_cmd") or f"Restore routing table {tbl} on {name}",
                "fix_id": f"restore_route:{name}:{tbl}",
                "fix_node": name,
                "fix_cmd": rchk.get("restore_cmd"),
            })
        if expect_sub and expect_sub not in sec:
            entry["ok"] = False
            result["issues"].append({
                "severity": "CRIT",
                "component": f"route_table_{tbl}",
                "node": name,
                "message": f"Policy table {tbl} on {name} missing '{expect_sub}'",
                "hint": rchk.get("restore_cmd") or f"Restore routing table {tbl} on {name}",
                "fix_id": f"restore_route:{name}:{tbl}",
                "fix_node": name,
                "fix_cmd": rchk.get("restore_cmd"),
            })
        result["routes"].append(entry)

    ss_sec = extract_section(out_os, "__SS_BEGIN__", "__SS_END__")
    if ss_sec is not None:
        sock_chk = node.get("socket_checks") or {}
        close_wait = 0
        forbid_hits: dict[int, int] = {}
        forbid_ports = [int(p) for p in sock_chk.get("forbid_ports", [])]
        peer_ports = [int(p) for p in sock_chk.get("peer_ports", [])]
        peer_ips = [str(ip) for ip in sock_chk.get("peer_ips", [])]
        default_max_cw = 0 if (peer_ports or peer_ips) else 12
        max_cw = int(sock_chk.get("max_close_wait", default_max_cw))

        for ln in ss_sec.splitlines():
            if "CLOSE-WAIT" in ln or "CLOSE_WAIT" in ln:
                port_ok = not peer_ports or any(re.search(rf"[:.]{p}\b", ln) for p in peer_ports)
                ip_ok = not peer_ips or any(ip in ln for ip in peer_ips)
                if port_ok and ip_ok:
                    close_wait += 1
            if "ESTAB" in ln or "ESTABLISHED" in ln:
                for port in forbid_ports:
                    if re.search(rf"[:.]{port}\b", ln):
                        forbid_hits[port] = forbid_hits.get(port, 0) + 1

        result["sockets"] = {"close_wait": close_wait, "forbid_hits": forbid_hits}
        if sock_chk.get("check_close_wait") and close_wait > max_cw:
            scope_parts = []
            if peer_ports:
                scope_parts.append(f"port(s) {peer_ports}")
            if peer_ips:
                scope_parts.append(f"peer(s) {peer_ips}")
            scope_desc = f" on {' '.join(scope_parts)}" if scope_parts else ""
            result["issues"].append({
                "severity": "WARN",
                "component": "sockets",
                "node": name,
                "message": f"{name} has {close_wait} CLOSE-WAIT TCP socket(s){scope_desc} (max {max_cw})",
                "hint": "Inspect tincd / proxy processes for leaked half-closed sockets",
            })
        for port, cnt in forbid_hits.items():
            result["issues"].append({
                "severity": "CRIT",
                "component": "carrier_port",
                "node": name,
                "message": f"{name} still has {cnt} ESTABLISHED socket(s) on forbidden/throttled port :{port}",
                "hint": f"Verify Transports/PreferredTransports=https and run `{node.get('cli', 'tinc')} retry`",
                "fix_id": f"retry:{name}",
                "fix_node": name,
                "fix_cmd": f"{node.get('cli', 'tinc')} retry",
            })

        for pchk in node.get("port_checks", []):
            pnum = int(pchk["port"])
            lbl = pchk.get("label", str(pnum))
            listening = bool(
                re.search(rf"(LISTEN|LISTENING).*[:.]{pnum}\b", ss_sec)
            )
            result["ports"].append({"port": pnum, "label": lbl, "listening": listening})
            if not listening:
                result["issues"].append({
                    "severity": "CRIT",
                    "component": "service",
                    "node": name,
                    "message": f"Service '{lbl}' on {name} is NOT listening on :{pnum}",
                    "hint": f"Check service '{lbl}' daemon on {name}",
                })

    log_sec = extract_section(out_os, "__LOG_BEGIN__", "__LOG_END__")
    if log_sec is not None:
        patterns = [
            ("tls_verify_fail", r"Cannot verify TLS|certificate verify failed", "CRIT"),
            ("tls_error", r"(?:https|tls|ssl)[^:\n]*:\s*(?:read from .* failed|write to .* failed|handshake failed)", "WARN"),
            ("meta_fail", r"Could not set up a meta connection", "WARN"),
            ("buffer_drop", r"Flushing .* output buffer|buffer full|dropping packet", "WARN"),
        ]
        for key, pat, sev in patterns:
            matches = re.findall(pat, log_sec, flags=re.I)
            if matches:
                result["logs_anomalies"].append({"type": key, "count": len(matches)})
                result["issues"].append({
                    "severity": sev,
                    "component": "logs",
                    "node": name,
                    "message": f"Container logs on {name} (5m) show {len(matches)} '{key}' event(s)",
                    "hint": f"Inspect `{node.get('docker_bin', 'docker')} logs --tail 50 {node.get('container')}` on {name}",
                })

    for idx, p in enumerate(node.get("pings", []) if extract_section(out_os, "__PING_0_BEGIN__", "__PING_0_END__") is not None else []):
        psec = extract_section(out_os, f"__PING_{idx}_BEGIN__", f"__PING_{idx}_END__") or ""
        lbl = p.get("label", p["dst"])
        loss_m = re.search(r"(\d+(?:\.\d+)?)%\s*packet loss", psec)
        rtt_m = re.search(r"=\s*[\d.]+/([\d.]+)/([\d.]+)", psec)
        loss = float(loss_m.group(1)) if loss_m else 100.0
        avg_ms = float(rtt_m.group(1)) if rtt_m else None
        ok = loss <= float(p.get("max_loss_pct", 0.0)) and (
            avg_ms is not None and (p.get("max_avg_ms") is None or avg_ms <= float(p["max_avg_ms"]))
        )
        result["pings"].append({"label": lbl, "dst": p["dst"], "loss_pct": loss, "avg_ms": avg_ms, "ok": ok})
        if not ok:
            result["issues"].append({
                "severity": "WARN" if loss < 100.0 else "CRIT",
                "component": "ping",
                "node": name,
                "message": f"Ping {lbl} ({p['dst']}): loss={loss:.0f}% avg={avg_ms if avg_ms is not None else '-'}ms",
                "hint": "Check underlay path, carrier congestion, or peer availability",
            })


def check_sni_urls(sni_urls: list[dict[str, Any]]) -> list[dict[str, Any]]:
    results = []
    for item in sni_urls:
        url = item["url"]
        expect = int(item.get("expect_code", 200))
        t0 = time.monotonic()
        rc, out, err = run_cmd(
            ["curl", "--noproxy", "*", "-sS", "-o", "/dev/null", "-w", "%{http_code} %{time_total}", "--max-time", "8", url],
            timeout=10.0,
        )
        dt = time.monotonic() - t0
        parts = out.strip().split()
        code = int(parts[0]) if parts and parts[0].isdigit() else 0
        t_tot = float(parts[1]) if len(parts) > 1 else dt
        ok = rc == 0 and code == expect
        results.append({"url": url, "code": code, "expect": expect, "time_s": round(t_tot, 3), "ok": ok, "err": err.strip()})
    return results


def curl_transfer_bps(url: str, extra_args: list[str], timeout: float = 40.0) -> tuple[bool, int, float, str]:
    t0 = time.monotonic()
    rc, out, err = run_cmd(
        ["curl", "--noproxy", "*", "-sS", "-o", "/dev/null", "-w", "%{size_download} %{time_total} %{speed_download} %{http_code}", *extra_args, url],
        timeout=timeout,
    )
    dt = max(time.monotonic() - t0, 1e-3)
    parts = out.strip().split()
    size_b = int(float(parts[0])) if len(parts) >= 1 and parts[0].replace(".", "", 1).isdigit() else 0
    t_s = float(parts[1]) if len(parts) >= 2 else dt
    http_c = int(parts[3]) if len(parts) >= 4 and parts[3].isdigit() else 0
    mbps = (size_b * 8.0) / (max(t_s, 1e-3) * 1_000_000.0)
    ok = rc == 0 and http_c in (200, 206) and size_b > 0
    return ok, size_b, mbps, err.strip()


def run_benchmark(bench_cfg: dict[str, Any]) -> dict[str, Any]:
    out: dict[str, Any] = {"checks": [], "diagnosis": None, "issues": []}

    wan = bench_cfg.get("direct_wan")
    wan_mbps = None
    if wan:
        args = ["--max-time", "12"]
        if wan.get("resolve"):
            args.extend(["--resolve", wan["resolve"]])
        ok, sz, mbps, err = curl_transfer_bps(wan["url"], args, timeout=15.0)
        wan_mbps = mbps if ok else 0.0
        out["checks"].append({
            "name": wan.get("label", "direct_wan"),
            "ok": ok,
            "bytes": sz,
            "mbps": round(mbps, 2),
            "err": err,
        })

    lat = bench_cfg.get("vpn_latency")
    if lat:
        route_ip = lat.get("route_probe_ip")
        if route_ip:
            _, r_out, _ = run_cmd(["ip", "route", "get", str(route_ip)], timeout=5.0)
            out["route_probe"] = r_out.strip()
        runs = int(lat.get("runs", 3))
        times: list[float] = []
        dns_times: list[float] = []
        codes: list[int] = []
        rcs: list[int] = []
        for i in range(runs + 1):
            rc, c_out, _ = run_cmd(
                [
                    "curl", "--noproxy", "*", "-sS", "-o", "/dev/null",
                    "-w", "%{http_code} %{time_namelookup} %{time_connect} %{time_appconnect} %{time_total}",
                    "--max-time", "12", lat["url"],
                ],
                timeout=14.0,
            )
            parts = c_out.strip().split()
            code = int(parts[0]) if parts and parts[0].isdigit() else 0
            t_dns = float(parts[1]) if len(parts) > 1 else 12.0
            t_s = float(parts[4]) if len(parts) > 4 else (float(parts[1]) if len(parts) > 1 else 12.0)
            if i > 0:  # skip cold warm-up run when computing steady-state average
                rcs.append(rc)
                codes.append(code)
                dns_times.append(t_dns)
                times.append(t_s)
        avg_s = sum(times) / len(times) if times else 99.0
        avg_dns_s = sum(dns_times) / len(dns_times) if dns_times else 99.0
        max_s = float(lat.get("max_sec", 1.5))
        ok = bool(times) and all(r == 0 for r in rcs) and all(c == 200 for c in codes) and avg_s <= max_s
        out["checks"].append({
            "name": "vpn_latency",
            "url": lat["url"],
            "steady_times_s": [round(t, 3) for t in times],
            "dns_times_s": [round(t, 3) for t in dns_times],
            "avg_dns_s": round(avg_dns_s, 3),
            "avg_s": round(avg_s, 3),
            "codes": codes,
            "ok": ok,
        })
        if not ok:
            out["issues"].append({
                "severity": "WARN",
                "component": "bench_latency",
                "node": "local",
                "message": (
                    f"VPN web latency steady avg {avg_s:.3f}s "
                    f"(dns_avg={avg_dns_s:.3f}s, codes={codes}, target <= {max_s:.1f}s)"
                ),
                "hint": "Check DNS relay (`127.0.0.1:53` on router), slow ECMP legs (`tinc doctor`), and policy routes",
            })

    tp = bench_cfg.get("vpn_throughput")
    single_mbps = None
    parallel_mbps = None
    if tp:
        ua = tp.get("user_agent", "curl/8.5.0")
        s_bytes = int(tp.get("single_bytes", 16 * 1024 * 1024))
        s_url_tpl = str(tp["url"])
        if "{bytes}" in s_url_tpl:
            s_url = s_url_tpl.format(bytes=s_bytes)
            s_args = ["-A", ua, "--max-time", "30"]
        elif "__down?bytes=" in s_url_tpl:
            s_url = s_url_tpl
            s_args = ["-A", ua, "--max-time", "30"]
        else:
            s_url = s_url_tpl
            s_args = ["-A", ua, "-r", f"0-{s_bytes - 1}", "--max-time", "30"]
        ok_s, sz_s, mbps_s, err_s = curl_transfer_bps(
            s_url,
            s_args,
            timeout=35.0,
        )
        single_mbps = mbps_s
        out["checks"].append({
            "name": "vpn_single_stream",
            "ok": ok_s,
            "bytes": sz_s,
            "mbps": round(single_mbps, 2),
            "err": err_s,
        })

        npar = int(tp.get("parallel_streams", 4))
        p_bytes = int(tp.get("parallel_bytes_each", 8 * 1024 * 1024))
        par_urls = [str(u) for u in tp.get("parallel_urls", [])] or [s_url_tpl]
        t0 = time.monotonic()
        with concurrent.futures.ThreadPoolExecutor(max_workers=npar) as ex:
            futs = []
            for k in range(npar):
                u_tpl = par_urls[k % len(par_urls)]
                if "{bytes}" in u_tpl:
                    p_url = u_tpl.format(bytes=p_bytes)
                    p_args = ["-A", ua, "--max-time", "35"]
                elif "__down?bytes=" in u_tpl:
                    p_url = u_tpl
                    p_args = ["-A", ua, "--max-time", "35"]
                else:
                    start = k * p_bytes
                    end = start + p_bytes - 1
                    p_url = u_tpl
                    p_args = ["-A", ua, "-r", f"{start}-{end}", "--max-time", "35"]
                futs.append(
                    ex.submit(
                        curl_transfer_bps,
                        p_url,
                        p_args,
                        40.0,
                    )
                )
            par_results = [f.result() for f in futs]
        wall_s = max(time.monotonic() - t0, 1e-3)
        tot_b = sum(r[1] for r in par_results)
        ok_p = all(r[0] for r in par_results) and tot_b > 0
        parallel_mbps = (tot_b * 8.0) / (wall_s * 1_000_000.0) if tot_b > 0 else 0.0
        out["checks"].append({
            "name": f"vpn_parallel_{npar}x",
            "ok": ok_p,
            "bytes": tot_b,
            "wall_s": round(wall_s, 3),
            "mbps": round(parallel_mbps, 2),
        })

        min_mbps = float(tp.get("min_mbps", 12.0))
        min_single_mbps = float(tp.get("min_single_mbps", min_mbps))
        tp_ok = ok_s and ok_p and single_mbps >= min_single_mbps and parallel_mbps >= min_mbps
        if not tp_ok:
            if wan_mbps is not None and wan_mbps < min_mbps:
                diag = "ISP/WAN upstream itself is slow (direct WAN below target)"
            elif not ok_s or single_mbps < min_single_mbps:
                diag = "Single-flow pacing / ECMP skew or stall; check `tinc doctor` and `tinc multipath recycle`"
            elif not ok_p:
                diag = "Parallel transfer stream failure / throttling; check target endpoint or per-leg ECMP"
            else:
                diag = "VPN throughput bottleneck (check carrier port/TSPU, ECMP skew, or VPS egress)"
            out["diagnosis"] = diag
            out["issues"].append({
                "severity": "CRIT",
                "component": "bench_throughput",
                "node": "local",
                "message": (
                    f"VPN throughput single={single_mbps:.2f} Mbps (ok={ok_s}), "
                    f"{npar}x parallel={parallel_mbps:.2f} Mbps (ok={ok_p}, target >= {min_single_mbps:.1f}/{min_mbps:.1f} Mbps)"
                ),
                "hint": diag,
            })
        else:
            out["diagnosis"] = "OK (VPN data plane >= target)"

    return out


def collect_fixes(node_results: list[dict[str, Any]], topo: dict[str, Any]) -> list[dict[str, str]]:
    node_map = {n["name"]: n for n in topo.get("nodes", []) if "name" in n}
    actions: list[dict[str, str]] = []
    seen: set[str] = set()

    for res in node_results:
        nname = res["name"]
        ncfg = node_map.get(nname, {})
        cli = ncfg.get("cli", "tinc")
        doc = res.get("doctor") or {}

        for iss in doc.get("issues", []):
            comp = iss.get("component")
            if comp in ("ecmp_skew", "tcp_cwnd", "tcp_retrans", "stall"):
                fid = f"recycle:{nname}"
                if fid not in seen:
                    seen.add(fid)
                    actions.append({
                        "id": fid,
                        "node": nname,
                        "desc": f"Zero-drop recycle slow ECMP connections on {nname}",
                        "cmd": f"{cli} multipath recycle all slow",
                    })
            elif comp in ("connect", "carrier"):
                fid = f"retry:{nname}"
                if fid not in seen:
                    seen.add(fid)
                    actions.append({
                        "id": fid,
                        "node": nname,
                        "desc": f"Retry outgoing connections on {nname} ({iss.get('message', '')})",
                        "cmd": f"{cli} retry",
                    })

        for iss in res.get("issues", []):
            fid = iss.get("fix_id")
            fcmd = iss.get("fix_cmd")
            if fid and fcmd and fid not in seen:
                seen.add(fid)
                actions.append({
                    "id": fid,
                    "node": nname,
                    "desc": iss.get("message", fid),
                    "cmd": fcmd,
                })

    return actions


def apply_fixes(
    actions: list[dict[str, str]],
    topo: dict[str, Any],
    agent_sock: str | None,
    assume_yes: bool,
) -> list[dict[str, Any]]:
    if not actions:
        return []
    node_map = {n["name"]: n for n in topo.get("nodes", []) if "name" in n}
    applied = []

    for act in actions:
        do_it = assume_yes
        if not assume_yes:
            if not sys.stdin.isatty():
                print(f"[FIX-SKIPPED] Non-interactive shell; pass --yes to apply: {act['desc']} -> `{act['cmd']}`")
                applied.append({**act, "applied": False, "reason": "non-interactive"})
                continue
            ans = input(f"Apply fix on {act['node']}: {act['desc']}?\n  cmd: {act['cmd']}\nProceed [y/N]? ").strip().lower()
            do_it = ans in ("y", "yes")

        if not do_it:
            applied.append({**act, "applied": False, "reason": "declined"})
            continue

        ncfg = node_map.get(act["node"], {"name": act["node"], "ssh": "local"})
        rc, out, err = run_on_node(ncfg, act["cmd"], agent_sock, timeout=30.0)
        applied.append({
            "id": act["id"],
            "node": act["node"],
            "cmd": act["cmd"],
            "applied": True,
            "rc": rc,
            "output": (out + err).strip(),
        })
        print(f"[FIX rc={rc}] {act['node']}: {act['cmd']}")
        if out.strip():
            print(f"  {out.strip()}")

    return applied


def print_text_summary(
    topo_path: Path | None,
    node_results: list[dict[str, Any]],
    sni_results: list[dict[str, Any]],
    bench_result: dict[str, Any] | None,
    all_issues: list[dict[str, Any]],
) -> None:
    src = str(topo_path) if topo_path else "local (no topology file found)"
    crits = sum(1 for i in all_issues if i.get("severity") == "CRIT")
    warns = sum(1 for i in all_issues if i.get("severity") == "WARN")
    overall = "UNHEALTHY" if crits else ("DEGRADED" if warns else "HEALTHY")

    print(f"=== vpn-diag [{overall}] topology={src} crit={crits} warn={warns} ===")
    for nr in node_results:
        doc = nr.get("doctor") or {}
        st = doc.get("status", "UNKNOWN" if nr["ssh_ok"] else "SSH_DOWN")
        mode = doc.get("multipath_mode", "-")
        peers = [p for p in doc.get("peers", []) if p.get("reachable")]
        conns = doc.get("connections", [])
        rt_str = " ".join(f"t{r['table']}={r['count']}({'ok' if r['ok'] else 'BAD'})" for r in nr["routes"])
        cw = nr.get("sockets", {}).get("close_wait")
        cw_str = f" close_wait={cw}" if cw is not None else ""
        print(f"\n[node {nr['name']}] status={st} mode={mode} reach_peers={len(peers)} conns={len(conns)} {rt_str}{cw_str}")
        for p in peers:
            p_conns = [c for c in conns if c.get("peer") == p["name"]]
            carriers = sorted({c.get("carrier", "?") for c in p_conns})
            rtts = [c.get("min_rtt_ms") for c in p_conns if (c.get("min_rtt_ms") or -1) > 0]
            scores = [c.get("score") for c in p_conns if c.get("score") is not None]
            rtt_span = f"{min(rtts):.1f}..{max(rtts):.1f}ms" if rtts else "-"
            score_s = f" score={min(scores)}..{max(scores)}" if scores else ""
            ap_bps = p.get("auto_pacing_Bps") or 0
            ap_s = f" autopacing={ap_bps * 8.0 / 1e6:.1f}Mbps" if ap_bps > 0 else ""
            probe_s = ""
            if "probe_ok" in p:
                probe_s = f" ping56={'ok' if p['probe_ok'] else 'FAIL'}({p.get('probe_rtt_ms', -1):.1f}ms) mtu1280={p.get('probe_mtu1280_ok')}"
            print(
                f"  -> peer {p['name']:12s} conns={len(p_conns)} carriers={','.join(carriers) or '-'} "
                f"min_rtt={rtt_span}{score_s}{ap_s} udp={p.get('udp_ok')} mtu={p.get('mtu')}{probe_s}"
            )
        for pg in nr.get("pings", []):
            avg = f"{pg['avg_ms']:.1f}ms" if pg["avg_ms"] is not None else "-"
            print(f"  -> ping {pg['label']}: loss={pg['loss_pct']:.0f}% avg={avg} ok={pg['ok']}")
        for pt in nr.get("ports", []):
            print(f"  -> port :{pt['port']} ({pt['label']}): {'LISTENING' if pt['listening'] else 'DOWN'}")

    if sni_results:
        print("\n[sni/https fronts]")
        for s in sni_results:
            print(f"  {s['url']}: HTTP {s['code']} in {s['time_s']:.3f}s ({'OK' if s['ok'] else 'FAIL'})")

    if bench_result:
        print("\n[benchmark]")
        if bench_result.get("route_probe"):
            print(f"  route: {bench_result['route_probe']}")
        for chk in bench_result.get("checks", []):
            if "mbps" in chk:
                print(f"  {chk['name']:20s}: {chk['mbps']:6.2f} Mbps ({chk['bytes']} B, ok={chk['ok']})")
            elif "avg_s" in chk:
                dns_s = f" dns_avg={chk['avg_dns_s']:.3f}s" if "avg_dns_s" in chk else ""
                print(f"  {chk['name']:20s}: avg={chk['avg_s']:.3f}s{dns_s} runs={chk['steady_times_s']} codes={chk['codes']} ok={chk['ok']}")
        if bench_result.get("diagnosis"):
            print(f"  diagnosis           : {bench_result['diagnosis']}")

    print("\n[findings]")
    if not all_issues:
        print("  [OK] Mesh routing, carriers, sockets, and buffers look healthy.")
    else:
        for iss in all_issues:
            print(f"  [{iss['severity']:4s}] ({iss['node']}:{iss['component']}) {iss['message']}")
            if iss.get("hint"):
                print(f"         -> {iss['hint']}")


def aggregate_issues(
    node_results: list[dict[str, Any]],
    sni_results: list[dict[str, Any]],
    bench_result: dict[str, Any] | None = None,
) -> list[dict[str, Any]]:
    all_issues: list[dict[str, Any]] = []
    for nr in node_results:
        for iss in nr.get("issues", []):
            all_issues.append(iss)
        doc = nr.get("doctor") or {}
        for iss in doc.get("issues", []):
            if iss.get("severity") == "INFO":
                continue
            all_issues.append({
                "severity": iss.get("severity", "WARN"),
                "component": iss.get("component", "doctor"),
                "node": f"{nr['name']}->{iss.get('peer', '-')}",
                "node_name": nr["name"],
                "message": iss.get("message", ""),
                "hint": iss.get("hint", ""),
            })
    for s in sni_results:
        if not s["ok"]:
            all_issues.append({
                "severity": "CRIT",
                "component": "sni_front",
                "node": "edge",
                "message": f"SNI endpoint {s['url']} returned HTTP {s['code']} (expected {s['expect']}): {s['err']}",
                "hint": "Inspect Angie sni-mux/http.d config and backend port",
            })
    if bench_result:
        all_issues.extend(bench_result.get("issues", []))
    return all_issues


def gather_mesh_state(
    nodes: list[dict[str, Any]],
    sni_urls: list[dict[str, Any]],
    agent_sock: str | None,
    do_probe: bool,
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]]]:
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(len(nodes), 1)) as ex:
        futs = [ex.submit(collect_node, n, agent_sock, do_probe) for n in nodes]
        node_results = [f.result() for f in futs]
    sni_results = check_sni_urls(sni_urls)
    return node_results, sni_results, aggregate_issues(node_results, sni_results)


def classify_health(all_issues: list[dict[str, Any]]) -> str:
    crits = sum(1 for i in all_issues if i.get("severity") == "CRIT")
    warns = sum(1 for i in all_issues if i.get("severity") == "WARN")
    if crits > 0:
        return "UNHEALTHY"
    if warns > 0:
        return "DEGRADED"
    return "HEALTHY"


def node_has_critical_failure(nr: dict[str, Any]) -> bool:
    if not nr.get("ssh_ok", True):
        return False
    for iss in nr.get("issues", []):
        if iss.get("severity") == "CRIT":
            return True
    doc = nr.get("doctor") or {}
    if doc.get("status") in ("CRITICAL", "ERROR", "DOWN"):
        return True
    for iss in doc.get("issues", []):
        if iss.get("severity") == "CRIT":
            return True
    return False


def load_watch_state(path: Path) -> dict[str, Any]:
    default_state: dict[str, Any] = {
        "last_status": "UNKNOWN",
        "last_issue_key": "",
        "last_alert_ts": 0.0,
        "crit_streak": {},
        "last_restart_ts": {},
    }
    try:
        if path.is_file():
            with path.open("r", encoding="utf-8") as fh:
                loaded = json.load(fh)
            if isinstance(loaded, dict):
                default_state.update(loaded)
    except Exception:
        pass
    return default_state


def save_watch_state(path: Path, state: dict[str, Any]) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(".tmp")
        with tmp.open("w", encoding="utf-8") as fh:
            json.dump(state, fh, indent=2)
        os.replace(tmp, path)
    except OSError:
        pass


def append_watch_event(events_path: Path, event: dict[str, Any]) -> None:
    try:
        events_path.parent.mkdir(parents=True, exist_ok=True)
        if events_path.is_file() and events_path.stat().st_size > EVENTS_MAX_BYTES:
            data = events_path.read_bytes()[-EVENTS_MAX_BYTES // 2 :]
            nl = data.find(b"\n")
            if nl >= 0:
                data = data[nl + 1 :]
            events_path.write_bytes(data)
        with events_path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(event, ensure_ascii=False) + "\n")
    except OSError:
        pass


def resolve_alert_config(topo: dict[str, Any]) -> dict[str, Any]:
    raw = topo.get("alerts") if isinstance(topo.get("alerts"), dict) else {}
    return {
        "telegram_bot_token": str(os.environ.get("VPN_DIAG_TG_BOT_TOKEN") or raw.get("telegram_bot_token") or "").strip(),
        "telegram_chat_id": str(os.environ.get("VPN_DIAG_TG_CHAT_ID") or raw.get("telegram_chat_id") or "").strip(),
        "webhook_url": str(os.environ.get("VPN_DIAG_WEBHOOK_URL") or raw.get("webhook_url") or "").strip(),
        "repeat_crit_sec": float(raw.get("repeat_crit_sec", 0) or 0),
    }


def _http_post_json(url: str, payload: dict[str, Any], timeout: float = 8.0) -> tuple[bool, str]:
    body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=body,
        headers={"Content-Type": "application/json; charset=utf-8"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return 200 <= resp.status < 300, f"HTTP {resp.status}"
    except (urllib.error.URLError, OSError) as exc:
        return False, str(exc)


def send_alert(
    topo: dict[str, Any],
    subject: str,
    body: str,
    http_post_fn: Any = _http_post_json,
) -> list[dict[str, Any]]:
    cfg = resolve_alert_config(topo)
    deliveries: list[dict[str, Any]] = []
    text = f"[tincstack] {subject}\n{body}".strip()

    if cfg["telegram_bot_token"] and cfg["telegram_chat_id"]:
        tg_url = f"https://api.telegram.org/bot{cfg['telegram_bot_token']}/sendMessage"
        ok, info = http_post_fn(tg_url, {"chat_id": cfg["telegram_chat_id"], "text": text})
        deliveries.append({"channel": "telegram", "ok": ok, "info": info})

    if cfg["webhook_url"]:
        ok, info = http_post_fn(cfg["webhook_url"], {"subject": subject, "text": text})
        deliveries.append({"channel": "webhook", "ok": ok, "info": info})

    return deliveries


def run_watch_iteration(
    topo: dict[str, Any],
    nodes: list[dict[str, Any]],
    agent_sock: str | None,
    do_probe: bool,
    state: dict[str, Any],
    *,
    now_ts: float | None = None,
    gather_fn: Any = gather_mesh_state,
    run_node_fn: Any = run_on_node,
    alert_fn: Any = send_alert,
    events_path: Path | None = None,
) -> dict[str, Any]:
    ts = float(now_ts if now_ts is not None else time.time())
    sni_urls = topo.get("sni_urls", [])
    node_results, sni_results, all_issues = gather_fn(nodes, sni_urls, agent_sock, do_probe)

    soft_fixes: list[dict[str, Any]] = []
    hard_restarts: list[dict[str, Any]] = []
    alerts_sent: list[dict[str, Any]] = []

    actions = collect_fixes(node_results, topo)
    if actions:
        node_map = {n["name"]: n for n in nodes if "name" in n}
        for act in actions:
            ncfg = node_map.get(act["node"], {"name": act["node"], "ssh": "local"})
            rc, out, err = run_node_fn(ncfg, act["cmd"], agent_sock, timeout=30.0)
            soft_fixes.append({
                "stage": 1,
                "id": act["id"],
                "node": act["node"],
                "cmd": act["cmd"],
                "rc": rc,
                "output": (out + err).strip(),
            })
        # Re-verify immediately after Stage 1 zero-drop fixes
        node_results, sni_results, all_issues = gather_fn(nodes, sni_urls, agent_sock, do_probe)

    crit_streak = dict(state.get("crit_streak") or {})
    last_restart_ts = dict(state.get("last_restart_ts") or {})
    node_map = {n["name"]: n for n in nodes if "name" in n}

    for nr in node_results:
        nname = nr["name"]
        ncfg = node_map.get(nname, {})
        has_crit = node_has_critical_failure(nr)
        if not has_crit:
            crit_streak[nname] = 0
            continue

        streak = int(crit_streak.get(nname, 0)) + 1
        crit_streak[nname] = streak
        container = ncfg.get("container")
        if not container or streak < STAGE2_CRIT_THRESHOLD:
            continue

        last_r = float(last_restart_ts.get(nname, 0.0) or 0.0)
        if last_r > 0.0 and ts - last_r < STAGE2_RESTART_COOLDOWN_SEC:
            continue

        docker_bin = ncfg.get("docker_bin", "docker")
        restart_cmd = f"{docker_bin} restart {shlex.quote(str(container))}"
        rc_r, out_r, err_r = run_node_fn(ncfg, restart_cmd, agent_sock, timeout=45.0)
        last_restart_ts[nname] = ts
        crit_streak[nname] = 0
        hard_restarts.append({
            "stage": 2,
            "node": nname,
            "container": container,
            "cmd": restart_cmd,
            "rc": rc_r,
            "output": (out_r + err_r).strip(),
        })
        if rc_r == 0:
            for rchk in ncfg.get("route_checks", []):
                rcmd = rchk.get("restore_cmd")
                if rcmd:
                    run_node_fn(ncfg, str(rcmd), agent_sock, timeout=20.0)

    if hard_restarts:
        node_results, sni_results, all_issues = gather_fn(nodes, sni_urls, agent_sock, do_probe)

    status = classify_health(all_issues)
    prev_status = str(state.get("last_status", "UNKNOWN"))
    issue_sigs = sorted(f"{i.get('severity')}:{i.get('node')}:{i.get('component')}" for i in all_issues)
    issue_key = "|".join(issue_sigs)
    prev_issue_key = str(state.get("last_issue_key", ""))
    cfg_alert = resolve_alert_config(topo)
    repeat_due = (
        status == "UNHEALTHY"
        and cfg_alert["repeat_crit_sec"] > 0
        and (ts - float(state.get("last_alert_ts", 0.0) or 0.0)) >= cfg_alert["repeat_crit_sec"]
    )

    lines_summary = [f"- [{i.get('severity')}] {i.get('node')}:{i.get('component')}: {i.get('message')}" for i in all_issues[:8]]
    if soft_fixes or hard_restarts:
        fix_desc = ", ".join(f"{f['node']}:stage{f['stage']}({f['cmd']})" for f in (soft_fixes + hard_restarts))
        auto_tag = f"AUTO-FIXED -> {status}" if status == "HEALTHY" else f"REMEDIATED -> {status}"
        if status != prev_status or hard_restarts or issue_key != prev_issue_key:
            alerts_sent.extend(
                alert_fn(topo, auto_tag, f"Actions: {fix_desc}\n" + "\n".join(lines_summary))
            )
            state["last_alert_ts"] = ts
    elif status in ("DEGRADED", "UNHEALTHY") and (
        status != prev_status or issue_key != prev_issue_key or repeat_due
    ):
        alerts_sent.extend(alert_fn(topo, f"Mesh {status}", "\n".join(lines_summary)))
        state["last_alert_ts"] = ts
    elif status == "HEALTHY" and prev_status in ("DEGRADED", "UNHEALTHY"):
        alerts_sent.extend(alert_fn(topo, "Mesh RECOVERED -> HEALTHY", f"All {len(nodes)} node(s) healthy."))
        state["last_alert_ts"] = ts

    state["last_status"] = status
    state["last_issue_key"] = issue_key
    state["crit_streak"] = crit_streak
    state["last_restart_ts"] = last_restart_ts

    event_rec = {
        "ts": ts,
        "status": status,
        "prev_status": prev_status,
        "crit": sum(1 for i in all_issues if i.get("severity") == "CRIT"),
        "warn": sum(1 for i in all_issues if i.get("severity") == "WARN"),
        "soft_fixes": soft_fixes,
        "hard_restarts": hard_restarts,
        "alerts": alerts_sent,
        "issues": lines_summary,
    }
    if events_path is not None and (status != prev_status or soft_fixes or hard_restarts or issue_key != prev_issue_key):
        append_watch_event(events_path, event_rec)

    return event_rec


def main() -> int:
    ap = argparse.ArgumentParser(description="Mesh-wide VPN diagnostics and semi-automatic fix tool")
    ap.add_argument("--topology", help="Path to vpn-diag topology JSON")
    ap.add_argument("--probe", action="store_true", help="Run active in-tunnel ICMP/PMTU probes and ping checks")
    ap.add_argument("--bench", action="store_true", help="Run direct WAN vs VPN latency & throughput benchmarks")
    ap.add_argument("--fix", action="store_true", help="Semi-automatically repair slow ECMP legs, missing routes, or stale connections")
    ap.add_argument("--yes", "-y", action="store_true", help="Auto-confirm --fix actions without prompting")
    ap.add_argument("--watch", action="store_true", help="Run continuous autonomous self-healing watchdog loop")
    ap.add_argument("--interval", type=int, default=90, help="Watchdog check interval in seconds (min 15, default 90)")
    ap.add_argument("--state-file", default=str(DEFAULT_STATE_FILE), help="Watchdog persistent state JSON path")
    ap.add_argument("--events-file", default=str(DEFAULT_EVENTS_FILE), help="Watchdog incident history JSONL path")
    ap.add_argument("--test-alert", action="store_true", help="Send a test Telegram/Webhook alert and exit")
    ap.add_argument("--json", action="store_true", help="Print full JSON report")
    args = ap.parse_args()

    try:
        topo, topo_path = load_topology(args.topology)
    except Exception as exc:
        print(f"vpn-diag: failed to load topology: {exc}", file=sys.stderr)
        return 1

    if args.test_alert:
        res = send_alert(topo, "Test Alert", f"Test notification from vpn-diag (topology={topo_path})")
        if not res:
            print("vpn-diag: no alerts configured (set alerts.telegram_bot_token/telegram_chat_id or webhook_url)", file=sys.stderr)
            return 1
        print(json.dumps(res, indent=2))
        return 0 if all(r["ok"] for r in res) else 1

    nodes = topo.get("nodes") or detect_local_tinc_node()
    if not nodes:
        print("vpn-diag: no topology file found and no local `tinc` binary on PATH.", file=sys.stderr)
        return 1

    agent_sock = find_ssh_agent()

    if args.watch:
        interval = max(15, int(args.interval))
        state_path = Path(args.state_file).expanduser()
        events_path = Path(args.events_file).expanduser()
        state = load_watch_state(state_path)
        print(f"vpn-diag --watch started (interval={interval}s, topology={topo_path or 'local'})", flush=True)
        while True:
            try:
                rec = run_watch_iteration(
                    topo,
                    nodes,
                    agent_sock,
                    args.probe,
                    state,
                    events_path=events_path,
                )
                save_watch_state(state_path, state)
                ts_s = time.strftime("%Y-%m-%d %H:%M:%S")
                print(
                    f"[{ts_s}] status={rec['status']} crit={rec['crit']} warn={rec['warn']} "
                    f"soft_fixes={len(rec['soft_fixes'])} hard_restarts={len(rec['hard_restarts'])}",
                    flush=True,
                )
            except KeyboardInterrupt:
                return 0
            except Exception as exc:
                print(f"[watch error] {exc}", file=sys.stderr, flush=True)
            try:
                time.sleep(interval)
            except KeyboardInterrupt:
                return 0

    node_results, sni_results, all_issues = gather_mesh_state(
        nodes, topo.get("sni_urls", []), agent_sock, args.probe
    )
    bench_result = run_benchmark(topo["bench"]) if (args.bench and topo.get("bench")) else None
    if bench_result:
        all_issues.extend(bench_result.get("issues", []))

    fix_log: list[dict[str, Any]] = []
    if args.fix:
        actions = collect_fixes(node_results, topo)
        fix_log = apply_fixes(actions, topo, agent_sock, args.yes)

    if args.json:
        print(
            json.dumps(
                {
                    "topology": str(topo_path) if topo_path else None,
                    "nodes": node_results,
                    "sni_urls": sni_results,
                    "benchmark": bench_result,
                    "issues": all_issues,
                    "fixes": fix_log,
                },
                indent=2,
            )
        )
    else:
        print_text_summary(topo_path, node_results, sni_results, bench_result, all_issues)

    crits = sum(1 for i in all_issues if i.get("severity") == "CRIT")
    return 1 if crits > 0 else 0


if __name__ == "__main__":
    raise SystemExit(main())
