platforms/linux/docker/.env
platforms/linux/docker/data/
# agent worktrees
.claude/
# platforms/windows — core binaries come from core/Dockerfile.build-win, never from git
platforms/windows/resources/
platforms/windows/tincmgr-data/
platforms/windows/**/*.exe
platforms/windows/**/*.dll
platforms/windows/**/*.pyc
platforms/windows/.pytest_cache/
# android (platforms/android): local SDK path, signing material, IDE files
platforms/android/local.properties
platforms/android/keystore.properties
platforms/android/app/release/
platforms/android/**/*.iml
platforms/android/.idea/
*.keystore
*.jks
# M9 lab runtime data (keys/configs generated at run time)
testing/smoke/run/
testing/smoke/run-*/
# testing/acme: generated CAs, server certs and per-case configs (keys!)
testing/acme/run/
# testing/config lab runtime (generated keys + configs)
testing/config/run-ifroute/
testing/config/run-pool/
testing/config/run-certlife/
testing/transports/run-repin/
testing/transports/run-frontport/
testing/transports/run-h3/
testing/transports/run-decoy/
testing/transports/run-wine/
testing/transports/run-android/
testing/transports/run-quic-wire/
testing/transports/run-quic-listener-wire/
# M9 lab runs: every lab.sh / dpi run.sh / `make check` run writes its full
# output (per-node tincd logs, dumps, pcaps) into results/run/<run-id>/ —
# never committed. The committed results/<date>/ trees hold only the curated
# subset that PLAN.md and the READMEs cite (`lab.sh promote` copies exactly
# the files un-ignored below); anything else under results/ stays ignored so a
# stray `git add` cannot bring 20 MB of node logs back.
testing/nat-sim/results/run/
testing/dpi-proof/results/run/
testing/nat-sim/results/**/*.dump.txt
testing/nat-sim/results/**/*.info.txt
testing/nat-sim/results/**/gw-*.txt
testing/dpi-proof/results/**/*.txt
!testing/dpi-proof/results/**/*.report.txt
!testing/nat-sim/results/*/laptop/*/nodel.log
!testing/nat-sim/results/*/glare-fix/**/*.log
# the two gateway dumps testing/nat-sim/README.md cites by path
!testing/nat-sim/results/*/pair-restricted-symmetric/core/gw-gwb.txt
!testing/nat-sim/results/*/pair-masq-portrestricted/baseline/gw-gwa.txt
testing/fingerprint/run/
