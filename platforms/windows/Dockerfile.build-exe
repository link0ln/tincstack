# Build tincmgr.exe (PyInstaller onefile) from Linux, inside Docker, by running
# a *Windows* CPython under Wine. Nothing is installed on the host.
#
#   platforms/windows/build-exe.sh
#   # = docker build -f platforms/windows/Dockerfile.build-exe \
#   #       -t tincstack/win-exe:dev platforms/windows/
#   #   docker run --rm -v "$PWD/platforms/windows:/work" tincstack/win-exe:dev
#   # -> platforms/windows/dist/tincmgr.exe   (gitignored, never enters git)
#
# The image carries: WineHQ stable with a 64-bit prefix (the 32-bit runtime is
# needed only by the python.org installer bootstrapper, which is a PE32 binary),
# the official python.org Windows installer run with /quiet under Xvfb, and the
# app's Windows wheels. PyInstaller then runs as a Windows process and takes the
# win_amd64 bootloader out of its own wheel — no cross-compiler is involved, and
# nothing here cross-builds: this is a native Windows build on an emulated ABI.
#
# Everything is pinned: the Wine package version, the Python version plus its
# installer SHA-256, and every wheel including the transitive ones.
#
# Limits (build-windows.md §2b): the Wine route cannot exercise Wintun, the
# UAC/elevation path, Windows service control, the tray/shell integration or
# code signing. It proves the bundle builds, that it is a PE32+ GUI binary, and
# that it starts far enough to build the Qt main window, read a tinc.yaml and
# find the bundled tincd.exe.
FROM debian:12.10-slim

ARG WINE_PKG_VERSION=11.0.0.0~bookworm-1
ARG WINEHQ_ARCHIVE_SHA256=d965d646defe94b3dfba6d5b4406900ac6c81065428bf9d9303ad7a72ee8d1b8
ARG PYTHON_VERSION=3.12.7
ARG PYTHON_INSTALLER_SHA256=1206721601a62c925d4e4a0dcfc371e88f2ddbe8c0c07962ebb2be9b5bde4570

ENV DEBIAN_FRONTEND=noninteractive

# Wine needs its i386 runtime: the python.org amd64 installer ships a 32-bit
# bootstrapper even though the payload it lays down is 64-bit.
RUN dpkg --add-architecture i386 \
    && apt-get -o Acquire::Retries=5 -o Dpkg::Use-Pty=0 update \
    && apt-get -o Acquire::Retries=5 -o Dpkg::Use-Pty=0 install -y --no-install-recommends \
         ca-certificates curl gnupg xvfb xauth unzip file binutils procps \
    && mkdir -pm755 /etc/apt/keyrings \
    && curl -fsSL --retry 5 --retry-all-errors https://dl.winehq.org/wine-builds/winehq.key \
         -o /etc/apt/keyrings/winehq-archive.key \
    && echo "${WINEHQ_ARCHIVE_SHA256}  /etc/apt/keyrings/winehq-archive.key" | sha256sum -c - \
    && curl -fsSL --retry 5 --retry-all-errors https://dl.winehq.org/wine-builds/debian/dists/bookworm/winehq-bookworm.sources \
         -o /etc/apt/sources.list.d/winehq-bookworm.sources \
    && apt-get -o Acquire::Retries=5 -o Dpkg::Use-Pty=0 update \
    && apt-get -o Acquire::Retries=5 -o Dpkg::Use-Pty=0 install -y --no-install-recommends "winehq-stable=${WINE_PKG_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

ENV WINEPREFIX=/wine \
    WINEARCH=win64 \
    WINEDEBUG=-all \
    WINEDLLOVERRIDES="mscoree,mshtml=" \
    WINPY="C:\\Python312\\python.exe"

# 64-bit prefix. `wineserver -w` after every wine command, so the registry is
# flushed to disk before the layer is committed.
RUN ulimit -n 65536 2>/dev/null || true; wineboot --init && wineserver -w

# Official python.org installer, checksum-verified, installed headless.
RUN ulimit -n 65536 2>/dev/null || true \
    && curl -fsSL --retry 5 --retry-all-errors -o /tmp/python-installer.exe \
      "https://www.python.org/ftp/python/${PYTHON_VERSION}/python-${PYTHON_VERSION}-amd64.exe" \
    && echo "${PYTHON_INSTALLER_SHA256}  /tmp/python-installer.exe" | sha256sum -c - \
    && xvfb-run -a wine /tmp/python-installer.exe /quiet InstallAllUsers=1 \
         PrependPath=1 Include_test=0 Include_doc=0 Include_tcltk=0 \
         TargetDir="C:\\Python312" \
    && wineserver -w \
    && rm -f /tmp/python-installer.exe \
    && wine "${WINPY}" -V && wineserver -w

# App dependencies for Windows + PyInstaller. Transitive versions AND wheel
# SHA-256 digests are pinned (`--require-hashes --no-deps`), so the image
# content is cryptographically verified and reproducible from this file alone.
RUN set -eux; \
    ulimit -n 65536 2>/dev/null || true; \
    cat <<'EOF' > /tmp/requirements-win.lock
PySide6-Essentials==6.7.3 --hash=sha256:f0950fcdcbcd4f2443336dc6a5fe692172adc225f876839583503ded0ab2f2a7
shiboken6==6.7.3 --hash=sha256:5f29325dfa86fde0274240f1f38e421303749d3174ce3ada178715b5f4719db9
pyqtgraph==0.13.7 --hash=sha256:7754edbefb6c367fa0dfb176e2d0610da3ada20aa7a5318516c74af5fb72bf7a
numpy==1.26.4 --hash=sha256:08beddf13648eb95f8d867350f6a018a4be2e5ad54c8d8caed89ebca558b2818
PyYAML==6.0.2 --hash=sha256:7e7401d0de89a9a855c839bc697c079a4af81cf878373abd7dc625847d25cbd8
pyinstaller==6.11.1 --hash=sha256:7ac83c0dc0e04357dab98c487e74ad2adb30e7eb186b58157a8faf46f1fa796f
pyinstaller-hooks-contrib==2026.7 --hash=sha256:24257a04c7a5a7a034cf28e39dcee20fbeeb9f043076729480f2e1b69904408a
altgraph==0.17.5 --hash=sha256:f3a22400bce1b0c701683820ac4f3b159cd301acab067c51c653e06961600597
pefile==2023.2.7 --hash=sha256:da185cd2af68c08a6cd4481f7325ed600a88f6a813bad9dea07ab3ef73d8d8d6
pywin32-ctypes==0.2.3 --hash=sha256:8a1513379d709975552d202d942d9837758905c8d01eb82b8bcc30918929e7b8
packaging==26.3 --hash=sha256:d7193f7c8e4e93f444fde0262bf90af30e16fa0ad0ad44cb553c87339b23cd1c
setuptools==84.0.0 --hash=sha256:51a52592b3b99e102b609654876bd65f19f999935166d1352678931132b0c670
EOF
    wine "${WINPY}" -m pip install --no-warn-script-location \
        --retries 5 --disable-pip-version-check --only-binary=:all: \
        --require-hashes --no-deps -r "Z:\\tmp\\requirements-win.lock" \
    && rm -f /tmp/requirements-win.lock \
    && wineserver -w \
    && wine "${WINPY}" -c "from PySide6 import QtCore; print('PySide6', QtCore.__version__)" \
    && wineserver -w

COPY pyinstaller-in-wine.sh /usr/local/bin/build-exe
RUN chmod +x /usr/local/bin/build-exe

# /work is platforms/windows/ from the repo, bind-mounted at run time.
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/build-exe"]
