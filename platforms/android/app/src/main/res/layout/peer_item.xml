<!-- One peer row: avatar, name/status/address, and a trailing more button
     that opens the actions menu (info and edit). Actions belong on the row,
     not hidden behind a whole-row tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/peer_row"
	style="@style/Tincstack.Row"
	android:clickable="true"
	android:focusable="true"
	android:paddingStart="16dp">

	<TextView
		android:id="@+id/peer_avatar"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_marginEnd="16dp"
		android:background="@drawable/bg_avatar"
		android:gravity="center"
		android:importantForAccessibility="no"
		android:textAppearance="?attr/textAppearanceTitleMedium"
		tools:text="N" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/peer_name"
			style="@style/Tincstack.RowTitle"
			tools:text="node_a" />

		<TextView
			android:id="@+id/peer_status"
			style="@style/Tincstack.RowSummary"
			tools:text="Direct · HTTPS · 0.7 ms" />

		<TextView
			android:id="@+id/peer_address"
			style="@style/Tincstack.RowSummary"
			android:textAppearance="?attr/textAppearanceBodySmall"
			tools:text="10.47.31.10 port 655" />
	</LinearLayout>

	<ImageView
		android:id="@+id/peer_menu"
		android:layout_width="24dp"
		android:layout_height="24dp"
		android:layout_marginStart="8dp"
		android:background="?attr/selectableItemBackgroundBorderless"
		android:contentDescription="@string/peer_edit_action"
		android:src="@android:drawable/ic_menu_more"
		app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
