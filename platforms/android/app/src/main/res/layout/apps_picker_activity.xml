<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/apps_disconnect_on_screen_off"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:text="@string/apps_picker_disconnect_on_screen_off" />

    <TextView
        android:id="@+id/apps_disconnect_on_screen_off_hint"
        style="@style/AppTheme.BlockContent"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:text="@string/apps_picker_disconnect_on_screen_off_hint" />

    <RadioGroup
        android:id="@+id/apps_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin">

        <RadioButton
            android:id="@+id/apps_mode_blacklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/apps_picker_mode_blacklist" />

        <RadioButton
            android:id="@+id/apps_mode_whitelist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apps_picker_mode_whitelist" />

    </RadioGroup>

    <TextView
        android:id="@+id/apps_mode_hint"
        style="@style/AppTheme.BlockContent"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:text="@string/apps_picker_mode_blacklist_hint" />

    <EditText
        android:id="@+id/apps_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/activity_horizontal_margin"
        android:layout_marginRight="@dimen/activity_horizontal_margin"
        android:hint="@string/apps_picker_search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1" />

    <ProgressBar
        android:id="@+id/apps_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <ListView
        android:id="@+id/apps_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:choiceMode="none"
        android:divider="@drawable/horizontal_line" />

</LinearLayout>
