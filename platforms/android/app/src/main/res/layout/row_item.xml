<!-- One list row: icon, title, summary, optional trailing view. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	style="@style/Tincstack.Row"
	android:clickable="true"
	android:focusable="true">

	<ImageView
		android:id="@+id/row_icon"
		style="@style/Tincstack.RowIcon"
		tools:src="@drawable/ic_transport"
		tools:ignore="ContentDescription" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/row_title"
			style="@style/Tincstack.RowTitle"
			tools:text="Connection type" />

		<TextView
			android:id="@+id/row_summary"
			style="@style/Tincstack.RowSummary"
			tools:text="Standard" />
	</LinearLayout>

	<com.google.android.material.materialswitch.MaterialSwitch
		android:id="@+id/row_switch"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="12dp"
		android:clickable="false"
		android:focusable="false"
		android:visibility="gone" />

	<ImageView
		android:id="@+id/row_chevron"
		android:layout_width="20dp"
		android:layout_height="20dp"
		android:layout_marginStart="8dp"
		android:importantForAccessibility="no"
		android:src="@drawable/ic_chevron_right"
		app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
