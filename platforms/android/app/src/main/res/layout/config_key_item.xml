<!-- One editable key of the config editor: section header (when it is the
     first row of its section), key name above an outlined value field,
     remove on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<TextView
		android:id="@+id/key_section"
		style="@style/Tincstack.SectionLabel"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingStart="24dp"
		android:paddingTop="14dp"
		android:visibility="gone"
		tools:text="Options" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="24dp"
		android:paddingTop="4dp"
		android:paddingEnd="16dp"
		android:paddingBottom="4dp">

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical">

			<TextView
				android:id="@+id/key_name"
				style="@style/Tincstack.RowTitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:fontFamily="monospace"
				tools:text="HttpsPort" />

			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/key_value_layout"
				style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/key_value"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:hint="@string/config_value_hint"
					android:inputType="text" />
			</com.google.android.material.textfield.TextInputLayout>
		</LinearLayout>

		<ImageView
			android:id="@+id/key_remove"
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:layout_marginStart="8dp"
			android:contentDescription="@string/action_remove"
			android:src="@android:drawable/ic_menu_delete"
			app:tint="?attr/colorError" />
	</LinearLayout>
</LinearLayout>
