<!-- Edit a peer's host record: the dial plan (address + ports) is editable,
     the identity (keys, subnets) is read-only below. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<LinearLayout
		android:id="@+id/peer_edit_root"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="24dp"
		android:paddingTop="16dp"
		android:paddingEnd="24dp"
		android:paddingBottom="24dp">

		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/peer_address_layout"
			style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:hint="@string/peer_edit_address_hint">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/peer_address"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:inputType="textUri"
				android:singleLine="true" />
		</com.google.android.material.textfield.TextInputLayout>

		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/peer_port_layout"
			style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:hint="@string/peer_edit_port_hint">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/peer_port"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:digits="0123456789"
				android:inputType="number"
				android:singleLine="true" />
		</com.google.android.material.textfield.TextInputLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:baselineAligned="false"
			android:orientation="horizontal">

			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/peer_https_port_layout"
				style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginEnd="6dp"
				android:layout_weight="1"
				android:hint="@string/peer_edit_https_hint">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/peer_https_port"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:digits="0123456789"
					android:inputType="number"
					android:singleLine="true" />
			</com.google.android.material.textfield.TextInputLayout>

			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/peer_quic_port_layout"
				style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="6dp"
				android:layout_weight="1"
				android:hint="@string/peer_edit_quic_hint">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/peer_quic_port"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:digits="0123456789"
					android:inputType="number"
					android:singleLine="true" />
			</com.google.android.material.textfield.TextInputLayout>
		</LinearLayout>

		<TextView
			android:id="@+id/peer_edit_note"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="10dp"
			android:text="@string/peer_edit_note"
			android:textAppearance="?attr/textAppearanceBodySmall"
			android:textColor="?attr/colorOnSurfaceVariant" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/peer_save"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:text="@string/action_save" />

		<TextView
			android:id="@+id/peer_identity_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingTop="20dp"
			android:paddingBottom="6dp"
			android:text="@string/peer_edit_identity"
			android:textAppearance="?attr/textAppearanceTitleSmall"
			android:textColor="?attr/colorOnSurfaceVariant" />

		<TextView
			android:id="@+id/peer_identity"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:fontFamily="monospace"
			android:textAppearance="?attr/textAppearanceBodySmall"
			android:textIsSelectable="true" />
	</LinearLayout>
</androidx.core.widget.NestedScrollView>
