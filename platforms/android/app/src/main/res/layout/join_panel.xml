<!-- Joining by invitation: the empty state of the main screen and the body of
     "Add network". Driven by activities/join/JoinPanel.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingStart="24dp"
	android:paddingTop="16dp"
	android:paddingEnd="24dp"
	android:paddingBottom="32dp">

	<FrameLayout
		android:id="@+id/join_hero"
		android:layout_width="88dp"
		android:layout_height="88dp"
		android:layout_gravity="center_horizontal"
		android:layout_marginTop="8dp"
		android:background="@drawable/bg_hero_circle">

		<ImageView
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_gravity="center"
			android:importantForAccessibility="no"
			android:src="@drawable/ic_mark"
			app:tint="?attr/colorOnPrimaryContainer" />
	</FrameLayout>

	<TextView
		android:id="@+id/join_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="20dp"
		android:gravity="center"
		android:text="@string/join_title"
		android:textAppearance="?attr/textAppearanceHeadlineSmall"
		android:textColor="?attr/colorOnSurface" />

	<TextView
		android:id="@+id/join_intro"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:gravity="center"
		android:text="@string/join_intro"
		android:textAppearance="?attr/textAppearanceBodyLarge"
		android:textColor="?attr/colorOnSurfaceVariant" />

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/clipboard_card"
		style="@style/Widget.Material3.CardView.Filled"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="20dp"
		android:visibility="gone"
		app:cardBackgroundColor="?attr/colorSecondaryContainer"
		app:cardCornerRadius="16dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="16dp"
			android:paddingTop="8dp"
			android:paddingEnd="8dp"
			android:paddingBottom="8dp">

			<ImageView
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:importantForAccessibility="no"
				android:src="@drawable/ic_paste"
				app:tint="?attr/colorOnSecondaryContainer" />

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="16dp"
				android:layout_weight="1"
				android:orientation="vertical">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/join_clipboard_title"
					android:textAppearance="?attr/textAppearanceTitleSmall"
					android:textColor="?attr/colorOnSecondaryContainer" />

				<TextView
					android:id="@+id/clipboard_endpoint"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textAppearance="?attr/textAppearanceBodyMedium"
					android:textColor="?attr/colorOnSecondaryContainer" />
			</LinearLayout>

			<Button
				android:id="@+id/clipboard_use"
				style="@style/Widget.Material3.Button.TextButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/join_clipboard_use" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

	<com.google.android.material.textfield.TextInputLayout
		android:id="@+id/invitation_layout"
		style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="20dp"
		android:hint="@string/join_input_hint"
		app:endIconContentDescription="@string/join_paste"
		app:endIconDrawable="@drawable/ic_paste"
		app:endIconMode="custom"
		app:helperText="@string/join_input_help"
		app:helperTextEnabled="true">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/invitation_input"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:fontFamily="monospace"
			android:gravity="top|start"
			android:importantForAutofill="no"
			android:inputType="textMultiLine|textNoSuggestions|textUri"
			android:maxLines="4"
			android:minLines="2"
			android:textSize="15sp" />
	</com.google.android.material.textfield.TextInputLayout>

	<Button
		android:id="@+id/join_button"
		style="@style/Widget.Material3.Button"
		android:layout_width="match_parent"
		android:layout_height="56dp"
		android:layout_marginTop="16dp"
		android:enabled="false"
		android:text="@string/join_action"
		android:textAppearance="?attr/textAppearanceTitleMedium" />

	<Button
		android:id="@+id/scan_button"
		style="@style/Widget.Material3.Button.OutlinedButton"
		android:layout_width="match_parent"
		android:layout_height="56dp"
		android:layout_marginTop="8dp"
		android:text="@string/join_scan"
		app:icon="@drawable/ic_qr_scan"
		app:iconGravity="textStart" />

	<LinearLayout
		android:id="@+id/join_progress"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="20dp"
		android:orientation="vertical"
		android:visibility="gone">

		<com.google.android.material.progressindicator.LinearProgressIndicator
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:indeterminate="true"
			app:trackCornerRadius="4dp" />

		<TextView
			android:id="@+id/join_progress_text"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:gravity="center"
			android:textAppearance="?attr/textAppearanceBodyMedium"
			android:textColor="?attr/colorOnSurfaceVariant" />
	</LinearLayout>

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/join_error"
		style="@style/Widget.Material3.CardView.Filled"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="20dp"
		android:visibility="gone"
		app:cardBackgroundColor="?attr/colorErrorContainer"
		app:cardCornerRadius="16dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingTop="16dp"
			android:paddingEnd="16dp"
			android:paddingBottom="8dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<ImageView
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:importantForAccessibility="no"
					android:src="@drawable/ic_error"
					app:tint="?attr/colorOnErrorContainer" />

				<TextView
					android:id="@+id/join_error_title"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="12dp"
					android:layout_weight="1"
					android:text="@string/join_failed_title"
					android:textAppearance="?attr/textAppearanceTitleMedium"
					android:textColor="?attr/colorOnErrorContainer" />
			</LinearLayout>

			<TextView
				android:id="@+id/join_error_message"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:textColor="?attr/colorOnErrorContainer" />

			<TextView
				android:id="@+id/join_error_log"
				style="@style/Tincstack.Mono"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:textColor="?attr/colorOnErrorContainer"
				android:textIsSelectable="true"
				android:visibility="gone" />

			<Button
				android:id="@+id/join_error_details"
				style="@style/Widget.Material3.Button.TextButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="end"
				android:text="@string/join_show_details"
				android:textColor="?attr/colorOnErrorContainer" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
