	<!-- connection type -->
	<string name="transport_plain">Standard</string>
	<string name="transport_plain_desc">tinc\'s own protocol over TCP and UDP. The fastest; use it unless your network blocks it.</string>
	<string name="transport_sf">Single UDP flow</string>
	<string name="transport_sf_desc">All traffic in one UDP flow. Can help behind strict NATs and firewalls.</string>
	<string name="transport_obfs">Obfuscated</string>
	<string name="transport_obfs_desc">Randomised packets without tinc\'s recognisable signature.</string>
	<string name="transport_https">HTTPS</string>
	<string name="transport_https_desc">Looks like an ordinary secure website connection. For networks that block VPNs.</string>
	<string name="transport_quic">QUIC</string>
	<string name="transport_quic_desc">Looks like HTTP/3 web traffic over UDP. For networks that block VPNs.</string>
