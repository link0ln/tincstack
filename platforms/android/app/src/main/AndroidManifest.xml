<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- the VpnService runs in the foreground while connected (TincVpnService.enterForeground):
         systemExempted is the type Android 14 reserves for VPN apps, specialUse the fallback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- the app picker lists every installed app (per-app split routing is what a VPN app is for) -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name="org.pacien.tincapp.context.App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tincstack"
        tools:ignore="GoogleAppIndexingWarning"
        tools:targetApi="s">

        <activity
            android:name=".activities.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <!-- the code builds these from the applicationId (intent/Actions.kt); a
                     hardcoded org.pacien.* name here would never match -->
                <action android:name="${applicationId}.intent.action.CONNECT" />
                <data android:scheme="tinc" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="${applicationId}.intent.action.DISCONNECT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.join.JoinActivity"
            android:exported="true"
            android:label="@string/add_network_title"
            android:parentActivityName=".activities.main.MainActivity"
            android:windowSoftInputMode="adjustResize">
            <!-- an invitation shared from a messenger -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.peers.PeersActivity"
            android:parentActivityName=".activities.main.MainActivity" />

        <activity
            android:name=".activities.config.ConfigEditorActivity"
            android:parentActivityName=".activities.main.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.log.LogActivity"
            android:parentActivityName=".activities.main.MainActivity" />

        <activity
            android:name=".activities.apps.AppPickerActivity"
            android:parentActivityName=".activities.main.MainActivity" />

        <service
            android:name="org.pacien.tincapp.service.TincVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="systemExempted|specialUse"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn: keeps the VpnService tunnel and its tinc daemon alive while connected" />
        </service>

    </application>

</manifest>
