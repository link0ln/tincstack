#!/usr/bin/env python3
"""tincstack-yaml -- minimal, structure-preserving editor for the daemon-owned tinc.yaml.

TEMPORARY BRIDGE. The tinc CLI (`tinc set` / `tinc add`) still edits the classic
tinc.conf / hosts/ tree and cannot address a YAML config; stream A (PLAN.md, M2)
is making it YAML-aware. Until that lands, the Linux entrypoint maps the few
deploy-time environment choices into the YAML with this helper. It is deliberately
tiny (python3 stdlib only), understands only the shapes the daemon itself emits
(block mappings + literal block scalars for host records), touches only the
requested key and leaves every other byte of the file alone. Replace every call
site with `tinc -c tinc.yaml set ...` once that works and delete this file.

Usage:
  tincstack-yaml get      <file> <net> <Key>
  tincstack-yaml set      <file> <net> <Key> <value>
  tincstack-yaml host-get <file> <net> <Name> <Var>
  tincstack-yaml host-set <file> <net> <Name> <Var> <value>

`get`/`host-get` print the value and exit 0, or exit 1 when absent.
`set`/`host-set` create the enclosing blocks when the file is empty or absent,
write atomically (temp + rename, mode 0600) under the same exclusive flock the
daemon takes, and exit 0. Values are restricted to plain YAML scalars.
"""

import fcntl
import os
import re
import sys

KEY_RE = re.compile(r"^(\s*)([A-Za-z0-9_.\-]+):(?:\s*(.*?))?\s*$")
SAFE_VALUE = re.compile(r"^[A-Za-z0-9_.:/\-]+$")
SAFE_HOST_VALUE = re.compile(r"^[A-Za-z0-9_.:/\- ]+$")
SAFE_NAME = re.compile(r"^[A-Za-z0-9_]+$")
BLOCK_SCALAR = re.compile(r"^\|[-+]?$")


def die(msg, code=2):
    sys.stderr.write("tincstack-yaml: %s\n" % msg)
    sys.exit(code)


def indent_of(line):
    return len(line) - len(line.lstrip(" "))


def is_skippable(line):
    s = line.strip()
    return not s or s.startswith("#")


def read_lines(path):
    if not os.path.exists(path):
        return []
    with open(path, "r", encoding="utf-8") as f:
        lines = f.read().splitlines(True)
    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"
    return lines


def write_lines(path, lines):
    tmp = "%s.%d.tmp" % (path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write("".join(lines))
        os.rename(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def mapping_body(lines, hdr):
    """[start, end) of the body of the mapping header at `hdr`: following lines
    indented deeper than the header; blank/comment lines inside are kept,
    trailing ones are excluded."""
    base = indent_of(lines[hdr])
    i = hdr + 1
    end = hdr + 1
    while i < len(lines):
        if is_skippable(lines[i]):
            i += 1
            continue
        if indent_of(lines[i]) <= base:
            break
        i += 1
        end = i
    return hdr + 1, end


def scalar_body(lines, hdr):
    """[start, end) of a literal block scalar (`key: |`): deeper-indented or
    whitespace-only lines; trailing whitespace-only lines are excluded."""
    base = indent_of(lines[hdr])
    i = hdr + 1
    end = hdr + 1
    while i < len(lines):
        if not lines[i].strip():
            i += 1
            continue
        if indent_of(lines[i]) <= base:
            break
        i += 1
        end = i
    return hdr + 1, end


def child_indent(lines, start, end, parent_indent):
    for i in range(start, end):
        if not is_skippable(lines[i]):
            return indent_of(lines[i])
    return parent_indent + 2


def find_key(lines, start, end, key, exact=True):
    """Index and match of the first direct child line in [start, end) whose key is `key`."""
    level = None
    for i in range(start, end):
        line = lines[i]
        if is_skippable(line):
            continue
        ind = indent_of(line)
        if level is None:
            level = ind
        if ind != level:
            continue
        m = KEY_RE.match(line)
        if not m:
            continue
        if m.group(2) == key or (not exact and m.group(2).lower() == key.lower()):
            return i, m
    return None, None


def ensure_mapping(lines, parent_hdr, key):
    """Return the header index of mapping `key` under `parent_hdr` (None = document
    root), creating an empty `key:` line at the end of the parent's body if absent."""
    if parent_hdr is None:
        start, end, parent_indent = 0, len(lines), -2
    else:
        start, end = mapping_body(lines, parent_hdr)
        parent_indent = indent_of(lines[parent_hdr])
    idx, m = find_key(lines, start, end, key)
    if idx is not None:
        if m.group(3):
            die("`%s:` is a scalar, expected a mapping" % key)
        return idx
    ind = child_indent(lines, start, end, parent_indent)
    lines.insert(end, " " * ind + key + ":\n")
    return end


def strip_quotes(value):
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def options_hdr(lines, net, create):
    if create:
        nets = ensure_mapping(lines, None, "networks")
        n = ensure_mapping(lines, nets, net)
        return ensure_mapping(lines, n, "options")
    nets, _ = find_key(lines, 0, len(lines), "networks")
    if nets is None:
        return None
    n, _ = find_key(lines, *mapping_body(lines, nets), net)
    if n is None:
        return None
    o, _ = find_key(lines, *mapping_body(lines, n), "options")
    return o


def cmd_get(path, net, key):
    lines = read_lines(path)
    o = options_hdr(lines, net, create=False)
    if o is None:
        return 1
    idx, m = find_key(lines, *mapping_body(lines, o), key, exact=False)
    if idx is None or not m.group(3):
        return 1
    print(strip_quotes(m.group(3)))
    return 0


def cmd_set(path, net, key, value):
    if not SAFE_VALUE.match(value):
        die("refusing value %r: only [A-Za-z0-9_.:/-] are accepted" % value)
    lines = read_lines(path)
    o = options_hdr(lines, net, create=True)
    start, end = mapping_body(lines, o)
    idx, m = find_key(lines, start, end, key, exact=False)
    if idx is not None:
        if m.group(3) and strip_quotes(m.group(3)) == value:
            return 0  # already the requested value: leave the file untouched
        lines[idx] = "%s%s: %s\n" % (m.group(1), m.group(2), value)
    else:
        ind = child_indent(lines, start, end, indent_of(lines[o]))
        lines.insert(end, "%s%s: %s\n" % (" " * ind, key, value))
    write_lines(path, lines)
    return 0


def host_hdr(lines, net, name, create):
    if create:
        nets = ensure_mapping(lines, None, "networks")
        n = ensure_mapping(lines, nets, net)
        hosts = ensure_mapping(lines, n, "hosts")
    else:
        nets, _ = find_key(lines, 0, len(lines), "networks")
        if nets is None:
            return None
        n, _ = find_key(lines, *mapping_body(lines, nets), net)
        if n is None:
            return None
        hosts, _ = find_key(lines, *mapping_body(lines, n), "hosts")
        if hosts is None:
            return None
    start, end = mapping_body(lines, hosts)
    idx, m = find_key(lines, start, end, name)
    if idx is not None:
        if not BLOCK_SCALAR.match(m.group(3) or ""):
            die("hosts.%s is not a literal block scalar (`%s: |`)" % (name, name))
        return idx
    if not create:
        return None
    ind = child_indent(lines, start, end, indent_of(lines[hosts]))
    lines.insert(end, "%s%s: |\n" % (" " * ind, name))
    return end


def host_line_var(line):
    """Variable name of a `Var = value` / `Var value` host-record line, or None."""
    s = line.strip()
    m = re.match(r"^([A-Za-z0-9_]+)\s*(?:=|\s)\s*(.*)$", s)
    return (m.group(1), m.group(2).strip()) if m else (None, None)


def cmd_host_get(path, net, name, var):
    lines = read_lines(path)
    h = host_hdr(lines, net, name, create=False)
    if h is None:
        return 1
    for i in range(*scalar_body(lines, h)):
        v, val = host_line_var(lines[i])
        if v and v.lower() == var.lower():
            print(val)
            return 0
    return 1


def cmd_host_set(path, net, name, var, value):
    if not SAFE_NAME.match(name):
        die("invalid node name %r" % name)
    if not SAFE_HOST_VALUE.match(value):
        die("refusing value %r: only [A-Za-z0-9_.:/- ] are accepted" % value)
    lines = read_lines(path)
    h = host_hdr(lines, net, name, create=True)
    start, end = scalar_body(lines, h)
    new = "%s = %s" % (var, value)
    for i in range(start, end):
        v, val = host_line_var(lines[i])
        if v and v.lower() == var.lower():
            if val == value:
                return 0  # already the requested value
            lines[i] = " " * indent_of(lines[i]) + new + "\n"
            write_lines(path, lines)
            return 0
    ind = child_indent(lines, start, end, indent_of(lines[h]))
    lines.insert(end, " " * ind + new + "\n")
    write_lines(path, lines)
    return 0


def main(argv):
    if len(argv) < 2:
        die(__doc__.strip(), 64)
    cmd, args = argv[1], argv[2:]
    arity = {"get": 3, "set": 4, "host-get": 4, "host-set": 5}
    if cmd not in arity or len(args) != arity[cmd]:
        die(__doc__.strip(), 64)
    path = args[0]
    lock = None
    if cmd in ("set", "host-set") and os.path.exists(path):
        lock = open(path, "r")
        fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        if cmd == "get":
            return cmd_get(*args)
        if cmd == "set":
            return cmd_set(*args)
        if cmd == "host-get":
            return cmd_host_get(*args)
        return cmd_host_set(*args)
    finally:
        if lock:
            lock.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
