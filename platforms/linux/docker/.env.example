# Copy to .env (git-ignored). Every value is optional; the daemon has a
# working default for each (PLAN.md M1, docs/config-schema.md).

# Network name (== tincd -n). Also the name of the tun interface.
#NETNAME=tincstack

# This node's name. First start only; afterwards the identity in the volume wins.
# Unset: the daemon derives one from the container hostname.
#NODE_NAME=hub

# Address (or host:port) peers reach this node at. Set it on any node that
# issues invitations: with it, `tinc invite` neither contacts tinc-vpn.org nor
# guesses a local address.
#PUBLIC_ADDRESS=vpn.example.org

# Listen port, also the port published on the host (default 655). An invitee
# dials out and can leave this unset.
#PORT=655

# Port of the https (TCP) and quic (UDP) fronts, published on the host as is
# (default 443). Peers are told this port, so no remapping. Set it to a free
# port when a web server already holds 443 on this host.
#FRONT_PORT=443

# Invitation string for a node that joins an existing mesh (first start only).
# `./join.sh <invitation>` sets this for you.
#INVITE=

# tincd -d level (0..5).
#LOG_LEVEL=1

# Image tag for the core and node images (default dev).
#TINCSTACK_TAG=dev
