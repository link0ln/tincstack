#!/bin/sh
# tinc-up -- give the tun interface its address on Linux.
#
# TEMPORARY, REMOVABLE. The M1 core does not yet configure the interface itself;
# stream A adds a built-in default. Until then this script derives the address
# from the node's own YAML: hosts.<Name> Subnet (a.b.c.d/32) gives the address,
# options.AddressPool gives the prefix length. Delete this file and the
# `install` line in entrypoint.sh once the daemon does it.
#
# Environment from tincd: INTERFACE, NAME, NETNAME. TINCSTACK_CONFIG from the
# entrypoint (falls back to the compose default path).
set -eu

cfg=${TINCSTACK_CONFIG:-/etc/tincstack/tinc.yaml}
subnet=$(tincstack-yaml host-get "$cfg" "$NETNAME" "$NAME" Subnet 2>/dev/null || true)
pool=$(tincstack-yaml get "$cfg" "$NETNAME" AddressPool 2>/dev/null || true)

ip link set dev "$INTERFACE" up

if [ -z "$subnet" ]; then
    echo "tinc-up: hosts.$NAME has no Subnet yet; $INTERFACE is up but unaddressed" >&2
    exit 0
fi

addr=${subnet%%/*}
case $pool in
    */*) prefix=${pool##*/} ;;
    *)   prefix=24 ;;
esac

ip addr replace "$addr/$prefix" dev "$INTERFACE"
echo "tinc-up: $INTERFACE $addr/$prefix" >&2
